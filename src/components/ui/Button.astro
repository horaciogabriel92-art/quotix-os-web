---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const { 
  variant = 'primary', 
  size = 'md', 
  href, 
  type = 'button',
  class: className = ''
} = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-semibold transition-all duration-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-[#0f172a]";

const variants = {
  primary: "bg-[#bf3480] text-white hover:bg-[#e879ab] focus:ring-[#bf3480] shadow-lg shadow-[#bf3480]/25",
  secondary: "bg-white text-[#0f172a] hover:bg-gray-100 focus:ring-white",
  ghost: "text-white hover:text-[#bf3480] hover:bg-white/5",
  outline: "border-2 border-[#334155] text-white hover:border-[#bf3480] hover:text-[#bf3480]"
};

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-base",
  lg: "px-8 py-4 text-lg"
};

const classes = `${baseStyles} ${variants[variant]} ${sizes[size]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
