---
interface Props {
  children: any;
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-[#bf3480]/10 text-[#e879ab] border border-[#bf3480]/20 ${className}`}>
  <span class="w-2 h-2 rounded-full bg-[#bf3480] mr-2 animate-pulse"></span>
  <slot />
</span>
