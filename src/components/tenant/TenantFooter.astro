---
const { tenant, landing } = Astro.props;

const redes = landing.redes_sociales || {};
const footerLinks = landing.footer_links || [];
const year = new Date().getFullYear();
---

<footer class="border-t mt-auto" style="background-color: rgba(0,0,0,0.02); border-color: rgba(0,0,0,0.08);">
  <div class="container-custom mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Marca -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          {tenant.logo_url ? (
            <img src={tenant.logo_url} alt={tenant.nombre} class="h-8 w-auto object-contain" />
          ) : (
            <div class="h-8 w-8 rounded-full flex items-center justify-center text-white font-bold text-xs" style={`background-color: var(--brand-primary);`}>
              {(landing.titulo || tenant.nombre || 'A').charAt(0)}
            </div>
          )}
          <span class="font-semibold" style="color: var(--brand-text);">{landing.titulo || tenant.nombre}</span>
        </div>
        {landing.direccion && (
          <p class="text-sm opacity-80">{landing.direccion}</p>
        )}
        {landing.horarios && (
          <p class="text-sm opacity-80">{landing.horarios}</p>
        )}
      </div>

      <!-- Contacto -->
      <div class="space-y-3">
        <h4 class="font-semibold text-sm uppercase tracking-wide" style="color: var(--brand-text);">Contacto</h4>
        {landing.telefono && <p class="text-sm opacity-80">Tel: {landing.telefono}</p>}
        {landing.whatsapp && <p class="text-sm opacity-80">WhatsApp: {landing.whatsapp}</p>}
        {landing.email && <p class="text-sm opacity-80">{landing.email}</p>}
      </div>

      <!-- Links -->
      <div class="space-y-3">
        <h4 class="font-semibold text-sm uppercase tracking-wide" style="color: var(--brand-text);">Links</h4>
        <ul class="space-y-2">
          {footerLinks.map((link: any) => (
            <li>
              <a href={link.url} class="text-sm opacity-80 hover:opacity-100 transition-opacity">{link.label}</a>
            </li>
          ))}
        </ul>
        {Object.keys(redes).length > 0 && (
          <div class="flex items-center gap-3 pt-2">
            {Object.entries(redes).map(([key, url]: [string, any]) =>
              url ? (
                <a
                  key={key}
                  href={url as string}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-medium opacity-80 hover:opacity-100 capitalize"
                >
                  {key}
                </a>
              ) : null
            )}
          </div>
        )}
      </div>
    </div>

    <div class="border-t mt-10 pt-6 text-center text-xs opacity-60" style="border-color: rgba(0,0,0,0.08);">
      <p>© {year} {landing.titulo || tenant.nombre}. {landing.footer_texto || 'Todos los derechos reservados.'}</p>
      <p class="mt-1">Powered by Quotix</p>
    </div>
  </div>
</footer>
