---
---

<section class="relative min-h-screen pt-16 bg-[#0f172a] overflow-hidden">
  <!-- Background blobs -->
  <div class="absolute top-0 left-0 w-[600px] h-[600px] bg-[#bf3480]/10 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2 animate-drift"></div>
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-[#d4f542]/5 rounded-full blur-3xl translate-x-1/4 -translate-y-1/4 animate-drift-reverse"></div>

  <div class="container-custom relative">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center pt-20 lg:pt-28 pb-20">
      
      <!-- Left: Copy -->
      <div class="max-w-xl">
        <!-- Badge -->
        <div class="hero-badge inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#bf3480]/10 border border-[#bf3480]/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-[#bf3480] animate-pulse"></span>
          <span class="text-xs font-semibold text-[#bf3480] tracking-wide uppercase">Para agencias de viajes que venden en serio</span>
        </div>

        <!-- H1 staggered lines -->
        <h1 class="heading-xl text-white mb-5">
          <span class="hero-line block">De 45 minutos a 3 minutos.</span>
          <span class="hero-line block text-[#d4f542]">Así es como venden más</span>
          <span class="hero-line block">las agencias que crecen.</span>
        </h1>

        <!-- Subheadline -->
        <p class="hero-sub body-lg text-slate-300 mb-8 max-w-lg">
          Convertí códigos PNR de Amadeus en cotizaciones profesionales en PDF y calculá tus comisiones al instante. Sin Excel. Sin errores. Sin perder ventas.
        </p>

        <!-- CTAs -->
        <div class="hero-ctas flex flex-wrap gap-3 mb-6">
          <a href="/precios" class="btn-primary btn-lime text-sm px-6 py-3">
            Probar gratis 7 días →
          </a>
          <a href="#video" class="btn-primary btn-outline-white text-sm px-6 py-3 flex items-center gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            Ver cómo funciona
          </a>
        </div>

        <!-- Microcopy -->
        <p class="hero-micro text-xs text-slate-400 flex flex-wrap gap-4">
          <span>✓ Sin tarjeta de crédito</span>
          <span>✓ Setup en 24hs</span>
          <span>✓ Cancelás cuando querés</span>
        </p>

        <!-- Stats -->
        <div class="flex gap-10 mt-10 pt-8 border-t border-white/10">
          <div class="hero-stat">
            <div class="text-3xl font-bold text-white" data-count="156" data-suffix="">0</div>
            <div class="text-xs text-slate-400 mt-1">cotizaciones hoy</div>
          </div>
          <div class="hero-stat">
            <div class="text-3xl font-bold text-white" data-count="200" data-prefix="+">0</div>
            <div class="text-xs text-slate-400 mt-1">agencias en LATAM</div>
          </div>
        </div>
      </div>

      <!-- Right: Mockup -->
      <div class="hero-mockup relative lg:pl-8">
        <div class="relative rounded-2xl overflow-hidden bg-white shadow-2xl shadow-black/30 animate-float">
          <!-- Window chrome -->
          <div class="px-4 py-3 bg-slate-50 border-b border-slate-100 flex items-center gap-2">
            <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-amber-400"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
            <span class="ml-4 text-xs text-slate-400">Quotix - Nueva Cotización</span>
          </div>

          <div class="p-5 space-y-3">
            <!-- Client row -->
            <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-100">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-[#bf3480]/10 flex items-center justify-center text-[#bf3480] font-bold text-sm">FG</div>
                <div>
                  <div class="font-medium text-slate-900 text-sm">Familia García López</div>
                  <div class="text-xs text-slate-500">3 pasajeros · 7 noches</div>
                </div>
              </div>
              <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-semibold rounded-full">Nueva</span>
            </div>

            <!-- Items -->
            <div class="space-y-2">
              <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                <div class="flex items-center gap-3">
                  <span class="text-lg">✈️</span>
                  <div>
                    <div class="text-sm font-medium text-slate-900">MVD ↔ MAD (ida y vuelta)</div>
                    <div class="text-xs text-slate-500">UX046 · 15 Mar · 09:30</div>
                  </div>
                </div>
                <div class="text-sm font-bold text-slate-900">$2,400</div>
              </div>
              <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                <div class="flex items-center gap-3">
                  <span class="text-lg">🏨</span>
                  <div>
                    <div class="text-sm font-medium text-slate-900">Hotel Riu Plaza Madrid</div>
                    <div class="text-xs text-slate-500">5 noches · Doble</div>
                  </div>
                </div>
                <div class="text-sm font-bold text-slate-900">$1,600</div>
              </div>
              <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                <div class="flex items-center gap-3">
                  <span class="text-lg">🚗</span>
                  <div>
                    <div class="text-sm font-medium text-slate-900">Transfer aeropuerto</div>
                    <div class="text-xs text-slate-500">Ida y vuelta</div>
                  </div>
                </div>
                <div class="text-sm font-bold text-slate-900">$180</div>
              </div>
            </div>

            <!-- Divider + Total -->
            <div class="flex items-center justify-between pt-3 border-t border-slate-200">
              <div>
                <div class="text-xs text-slate-500">Total cotización</div>
                <div class="text-xl font-bold text-slate-900">$4,180 USD</div>
              </div>
              <div class="text-right">
                <div class="text-xs text-slate-500">Tu comisión (12%)</div>
                <div class="text-base font-bold text-[#bf3480]">$501 🎉</div>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex gap-2">
              <button class="flex-1 py-2 text-xs font-semibold text-white bg-[#0f172a] rounded-lg">Generar PDF</button>
              <button class="flex-1 py-2 text-xs font-semibold text-slate-600 bg-slate-100 rounded-lg">Enviar cliente</button>
            </div>
          </div>
        </div>

        <!-- Scroll indicator -->
        <div class="absolute -bottom-14 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-slate-500 animate-bounce">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </div>

        <!-- Decorative -->
        <div class="absolute -top-4 -right-4 w-24 h-24 bg-gradient-to-br from-[#d4f542]/20 to-transparent rounded-full blur-2xl"></div>
        <div class="absolute -bottom-8 -left-8 w-32 h-32 bg-gradient-to-tr from-[#bf3480]/10 to-transparent rounded-full blur-3xl"></div>
      </div>
    </div>
  </div>
</section>

<style>
@keyframes float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-15px) rotate(1deg); }
}
@keyframes drift {
  0% { transform: translate(-50%, -50%) scale(1); }
  100% { transform: translate(calc(-50% + 30px), calc(-50% - 30px)) scale(1.1); }
}
@keyframes drift-reverse {
  0% { transform: translate(25%, -25%) scale(1); }
  100% { transform: translate(calc(25% - 30px), calc(-25% + 30px)) scale(1.1); }
}
.animate-float { animation: float 6s ease-in-out infinite; }
.animate-drift { animation: drift 20s ease-in-out infinite alternate; }
.animate-drift-reverse { animation: drift-reverse 20s ease-in-out infinite alternate; }

/* Entrance animations */
.hero-badge { opacity: 0; transform: translateX(-20px); }
.hero-line { opacity: 0; transform: translateY(30px); }
.hero-sub { opacity: 0; }
.hero-ctas { opacity: 0; transform: translateY(15px); }
.hero-micro { opacity: 0; }
.hero-stat { opacity: 0; }
.hero-mockup { opacity: 0; transform: translateY(40px); }
</style>

<script>
  (function() {
    function animateCount(el) {
      const target = parseInt(el.dataset.count);
      const prefix = el.dataset.prefix || '';
      const suffix = el.dataset.suffix || '';
      const duration = 2000;
      const step = duration / target;
      let current = 0;
      const timer = setInterval(() => {
        current = Math.min(current + Math.ceil(target / 60), target);
        el.textContent = prefix + current + suffix;
        if (current >= target) clearInterval(timer);
      }, duration / 60);
    }

    function runHero() {
      const badge = document.querySelector('.hero-badge');
      const lines = document.querySelectorAll('.hero-line');
      const sub = document.querySelector('.hero-sub');
      const ctas = document.querySelector('.hero-ctas');
      const micro = document.querySelector('.hero-micro');
      const stats = document.querySelectorAll('.hero-stat');
      const mockup = document.querySelector('.hero-mockup');

      const ease = 'cubic-bezier(0.25, 1, 0.5, 1)';
      const dur = '600ms';

      function show(el, delay, extra = {}) {
        setTimeout(() => {
          Object.assign(el.style, { transition: `all ${dur} ${ease}`, opacity: '1', transform: 'none', ...extra });
        }, delay);
      }

      show(badge, 0);
      lines.forEach((l, i) => show(l, 150 + i * 150));
      show(sub, 600);
      show(ctas, 750);
      show(micro, 900);
      stats.forEach((s, i) => show(s, 1000 + i * 200));
      show(mockup, 500);

      // Count up stats
      setTimeout(() => {
        document.querySelectorAll('[data-count]').forEach(animateCount);
      }, 1200);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', runHero);
    } else {
      runHero();
    }
  })();
</script>
