---
import { plans } from '@/content/plans';

const formatLimit = (value: number | null, singular: string, plural: string) => {
  if (value === null) return `Ilimitados`;
  return `${value} ${value === 1 ? singular : plural}`;
};
---

<section id="precios" class="section-padding bg-slate-50">
  <div class="container-custom">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#bf3480]/10 text-[#bf3480] text-sm font-semibold mb-4">
        Planes
      </span>
      <h2 class="heading-lg text-[#0f172a] mb-4">
        El plan perfecto para tu agencia
      </h2>
      <p class="body-md text-slate-600">
        7 días de prueba gratuita en todos los planes. Sin tarjeta de crédito.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 items-start">
      {plans.map((plan) => (
        <div class={`relative rounded-2xl p-6 flex flex-col h-full transition-all duration-300 hover:-translate-y-1 ${
          plan.destacado 
            ? 'bg-[#0f172a] text-white shadow-xl shadow-[#0f172a]/20 ring-2 ring-[#d4f542]' 
            : 'bg-white border border-slate-200 text-[#0f172a]'
        }`}>
          {plan.destacado && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <span class="px-3 py-1 rounded-full bg-[#d4f542] text-[#0f172a] text-xs font-bold">
                Más popular
              </span>
            </div>
          )}

          <div class="mb-6 text-center">
            {plan.icono && (
              <div class={`w-12 h-12 rounded-xl mx-auto mb-4 flex items-center justify-center text-2xl ${
                plan.destacado ? 'bg-white/10' : 'bg-slate-100'
              }`}>
                {plan.icono}
              </div>
            )}
            <h3 class="text-xl font-bold mb-1">{plan.nombre}</h3>
            <p class={`text-sm ${plan.destacado ? 'text-slate-400' : 'text-slate-500'}`}>
              {plan.subtitulo}
            </p>
          </div>

          <div class="text-center mb-6">
            <span class="text-4xl font-black">
              {plan.precio_mensual_usd === 0 ? 'Gratis' : `$${plan.precio_mensual_usd}`}
            </span>
            {plan.precio_mensual_usd > 0 && (
              <span class={`text-sm ${plan.destacado ? 'text-slate-400' : 'text-slate-500'}`}>/mes</span>
            )}
          </div>

          <a
            href={`/registro?plan=${plan.slug}`}
            class={`w-full text-center py-3 rounded-full font-semibold text-sm transition-all mb-6 ${
              plan.destacado
                ? 'bg-[#d4f542] text-[#0f172a] hover:bg-[#e0ff70]'
                : plan.precio_mensual_usd === 0
                  ? 'border-2 border-[#0f172a] text-[#0f172a] hover:bg-[#0f172a] hover:text-white'
                  : 'bg-[#0f172a] text-white hover:bg-[#1e293b]'
            }`}
          >
            {plan.cta}
          </a>

          <ul class="space-y-3 flex-1">
            {plan.features.map((feature) => (
              <li class={`flex items-start gap-3 text-sm ${
                feature.incluido 
                  ? (plan.destacado ? 'text-slate-200' : 'text-slate-700')
                  : (plan.destacado ? 'text-slate-600' : 'text-slate-400')
              }`}>
                {feature.incluido ? (
                  <svg class={`w-5 h-5 flex-shrink-0 mt-0.5 ${plan.destacado ? 'text-[#d4f542]' : 'text-[#bf3480]'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                ) : (
                  <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                )}
                <span>{feature.text}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
