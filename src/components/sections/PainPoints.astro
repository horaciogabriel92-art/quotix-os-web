---
const cards = [
  {
    icon: "⏱️",
    title: "45 minutos por cotización",
    bullets: [
      "El cliente se cansa de esperar y llama a otra agencia",
      "Solo pueden hacer 8-10 cotizaciones al día",
      "El equipo trabaja hasta tarde en tareas mecánicas",
    ],
    bar: 85,
    label: "Pérdida de tiempo"
  },
  {
    icon: "⚠️",
    title: "Errores que te cuestan plata",
    bullets: [
      "Una coma mal puesta y tu comisión desaparece",
      "Le cobrás mal al cliente y perdés credibilidad",
      "Rehacer cotizaciones que ya habías terminado",
    ],
    bar: 73,
    label: "Riesgo de error"
  },
  {
    icon: "📋",
    title: "Cada vendedor hace lo suyo",
    bullets: [
      "Uno usa Word, otro Excel, otro WhatsApp",
      "Tu marca parece amateur sin consistencia",
      "No sabés quién cotizó qué ni cuándo",
    ],
    bar: 91,
    label: "Falta de control"
  }
];
---

<section class="section-padding bg-[#0f172a]">
  <div class="container-custom">

    <!-- Header -->
    <div class="text-center mb-14 reveal">
      <p class="text-xs font-semibold text-[#bf3480] uppercase tracking-widest mb-3">¿Te suena familiar?</p>
      <h2 class="heading-lg text-white">
        Tu vendedor está perdiendo ventas<br>
        <span class="text-slate-400">y no es su culpa</span>
      </h2>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 mb-12">
      {cards.map((card, i) => (
        <div class="pain-card group p-7 rounded-2xl bg-slate-800/30 border border-slate-700/50 hover:bg-slate-800/60 hover:border-[#bf3480]/30 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-black/20" style={`transition-delay: ${i * 0.1}s`}>
          <!-- Icon -->
          <div class="text-4xl mb-4 block transition-transform duration-300 group-hover:scale-110">{card.icon}</div>
          <!-- Title -->
          <h3 class="heading-sm text-white mb-5">{card.title}</h3>
          <!-- Bullets -->
          <ul class="space-y-3 mb-6">
            {card.bullets.map((b, bi) => (
              <li class="pain-bullet flex items-start gap-3 text-sm text-slate-400" style={`transition-delay: ${bi * 0.1}s`}>
                <span class="text-[#bf3480] font-bold mt-0.5 flex-shrink-0">✗</span>
                {b}
              </li>
            ))}
          </ul>
          <!-- Progress bar -->
          <div>
            <div class="flex justify-between text-xs text-slate-500 mb-2">
              <span>{card.label}</span>
              <span class="font-semibold text-slate-300">{card.bar}%</span>
            </div>
            <div class="h-1.5 bg-slate-700 rounded-full overflow-hidden">
              <div
                class="pain-bar h-full bg-gradient-to-r from-[#bf3480] to-[#d4f542] rounded-full"
                style={`width: 0%; --target-width: ${card.bar}%`}
              ></div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center reveal">
      <p class="text-slate-400 mb-4">¿Te resuena alguno de estos problemas?</p>
      <a href="#demo" class="btn-primary btn-lime text-sm px-6 py-3">
        Agendá una demo y veamos cómo lo resolvemos →
      </a>
    </div>
  </div>
</section>

<style>
.pain-card { opacity: 0; transform: translateY(40px); transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1), transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), background 0.3s, border 0.3s, box-shadow 0.3s; }
.pain-card.active { opacity: 1; transform: translateY(0); }
.pain-bar { transition: width 1s ease-out; }
</style>

<script>
  (function() {
    const cards = document.querySelectorAll('.pain-card');
    if (!cards.length) return;

    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const card = entry.target;
          const idx = Array.from(cards).indexOf(card);
          setTimeout(() => {
            card.classList.add('active');
            // Animate bars
            card.querySelectorAll('.pain-bar').forEach(bar => {
              setTimeout(() => {
                bar.style.width = bar.style.getPropertyValue('--target-width');
              }, 400);
            });
          }, idx * 200);
          obs.unobserve(card);
        }
      });
    }, { threshold: 0.2 });

    cards.forEach(c => obs.observe(c));

    // Generic reveal
    document.querySelectorAll('.reveal').forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(30px)';
      el.style.transition = 'all 0.6s cubic-bezier(0.25, 1, 0.5, 1)';
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          el.style.opacity = '1';
          el.style.transform = 'none';
        }
      }, { threshold: 0.3 }).observe(el);
    });
  })();
</script>
