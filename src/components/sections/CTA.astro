---
---

<section class="section-padding bg-[#0f172a] relative overflow-hidden">
  <!-- Decorative blobs -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-[#bf3480]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-[#d4f542]/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-custom relative">
    <div class="max-w-2xl mx-auto text-center">

      <!-- Headline -->
      <h2 class="heading-lg text-white mb-4 reveal">
        ¿Listo para dejar de perder tiempo<br>en cotizaciones?
      </h2>

      <!-- Subheadline -->
      <p class="body-md text-slate-400 mb-8 reveal">
        Agendá una demo de 20 minutos. Vamos a:
      </p>

      <!-- Bullets -->
      <ul class="text-left max-w-md mx-auto space-y-3 mb-10">
        {[
          "Hacer una cotización con tus datos reales",
          "Mostrarte cómo se integra con tu GDS",
          "Darte un presupuesto exacto para tu agencia"
        ].map((b, i) => (
          <li class="cta-bullet flex items-center gap-3 text-slate-300 opacity-0" style={`transform: translateX(-20px); transition-delay: ${i * 0.1}s;`}>
            <div class="w-5 h-5 rounded-full bg-[#d4f542]/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-3 h-3 text-[#d4f542]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            {b}
          </li>
        ))}
      </ul>

      <!-- Primary CTA -->
      <div class="reveal mb-4">
        <a href="#demo" class="cta-pulse btn-primary btn-lime text-base px-8 py-4 shadow-lg shadow-[#d4f542]/20">
          Agendar demo gratuita
        </a>
        <p class="text-xs text-slate-500 mt-3">Sin compromiso. Sin tarjeta de crédito.</p>
      </div>

      <!-- Divider -->
      <div class="flex items-center gap-4 my-6 reveal">
        <div class="flex-1 h-px bg-white/10"></div>
        <span class="text-slate-500 text-xs">o</span>
        <div class="flex-1 h-px bg-white/10"></div>
      </div>

      <!-- WhatsApp -->
      <a href="https://wa.me/59899000000" class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-[#d4f542] transition-colors duration-200 reveal">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.570-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        ¿Tenés preguntas? Escribinos por WhatsApp →
      </a>

      <!-- Social proof -->
      <div class="flex items-center justify-center gap-3 mt-10 reveal">
        <div class="flex -space-x-2">
          {["MG","JR","AL","PC"].map(init => (
            <div class="avatar-dot w-9 h-9 rounded-full bg-slate-700 border-2 border-[#0f172a] flex items-center justify-center text-xs font-bold text-slate-300 opacity-0 scale-75">
              {init}
            </div>
          ))}
        </div>
        <p class="text-sm text-slate-400">
          <span class="text-white font-semibold">+200 agencias</span> ya cotizan más rápido
        </p>
      </div>
    </div>
  </div>
</section>

<style>
@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 0 0 rgba(212, 245, 66, 0.3); }
  50% { box-shadow: 0 0 0 12px rgba(212, 245, 66, 0); }
}
.cta-pulse { animation: pulse-glow 2s infinite; }
.cta-bullet { transition: opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1), transform 0.5s cubic-bezier(0.25, 1, 0.5, 1); }
.cta-bullet.active { opacity: 1; transform: translateX(0); }
.avatar-dot { transition: opacity 0.4s, transform 0.4s; }
.avatar-dot.active { opacity: 1; transform: scale(1); }
</style>

<script>
  (function() {
    const bullets = document.querySelectorAll('.cta-bullet');
    const avatars = document.querySelectorAll('.avatar-dot');

    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          bullets.forEach((b, i) => setTimeout(() => b.classList.add('active'), i * 100));
          avatars.forEach((a, i) => setTimeout(() => a.classList.add('active'), i * 80));
          obs.disconnect();
        }
      });
    }, { threshold: 0.2 });
    const section = document.querySelector('.cta-pulse');
    if (section) obs.observe(section.closest('section'));

    document.querySelectorAll('.reveal').forEach(el => {
      el.style.opacity = '0'; el.style.transform = 'translateY(20px)';
      el.style.transition = 'all 0.6s cubic-bezier(0.25, 1, 0.5, 1)';
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) { el.style.opacity = '1'; el.style.transform = 'none'; }
      }, { threshold: 0.2 }).observe(el);
    });
  })();
</script>
