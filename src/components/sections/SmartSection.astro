---
---

<section class="py-24 bg-[#0f172a]">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left content -->
      <div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white mb-12 leading-tight">
          What makes Quotix AI so smart?
        </h2>
        
        <div class="space-y-10">
          <div>
            <h3 class="text-xl font-semibold text-white mb-3">Rich data from all your customer interactions</h3>
            <p class="text-slate-400 leading-relaxed">
              Tens of millions of tickets and conversations are handled every week in Quotix, providing billions of data points that power AI customer support and continuously improve Quotix AI.
            </p>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-white mb-3">Unified knowledge sources</h3>
            <p class="text-slate-400 leading-relaxed">
              We bring your help content and past conversation data together to provide more relevant, accurate AI suggestions.
            </p>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-white mb-3">AI you can trust, because you're in control</h3>
            <p class="text-slate-400 leading-relaxed">
              Select your knowledge sources and determine what requires human review, so you can safely scale AI-powered automation over time without sacrificing quality.
            </p>
          </div>
        </div>
      </div>
      
      <!-- Right - Diagram visualization -->
      <div class="relative">
        <div class="relative rounded-2xl bg-[#1e293b]/50 p-8 border border-slate-700">
          <!-- Central hub -->
          <div class="flex justify-center mb-8">
            <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-[#bf3480] to-[#8b5cf6] flex items-center justify-center">
              <span class="text-3xl font-bold text-white">Q</span>
            </div>
          </div>
          
          <!-- Connection lines -->
          <div class="grid grid-cols-4 gap-4">
            {[1,2,3,4,5,6,7,8].map((i) => (
              <div class="flex flex-col items-center gap-2">
                <div class="w-12 h-12 rounded-xl bg-[#334155] flex items-center justify-center">
                  <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
