---
// No React dependency - pure Astro + Vanilla JS
---

<section class="section-padding bg-[#0f1523] border-t border-slate-800/50 overflow-hidden relative">
  <div class="container-custom">
    <div class="text-center max-w-3xl mx-auto mb-16 relative z-10">
      <h2 class="heading-lg text-white mb-4">
        Cotizaciones en PDF en segundos
      </h2>
      <p class="body-md text-slate-400">
        Simplemente pega tu código de PNR de Amadeus y nuestro motor inteligente construirá una cotización en PDF lista para enviar, detectando fechas, horas y aerolíneas.
      </p>
    </div>

    <!-- Desktop Animation -->
    <div class="hidden lg:flex justify-center relative z-10">
      <div id="demo-animation-root" class="demo-app-wrapper">
        <!-- Explanation Bubbles -->
        <div id="bubble-phase1" class="demo-bubble bubble-bottom" style="top:150px;left:50%;transform:translateX(-50%);">
          <span class="bubble-icon">✦</span>
          Pegas el PNR en crudo desde tu GDS (Amadeus, Sabre o Galileo).
        </div>
        <div id="bubble-phase2" class="demo-bubble bubble-right" style="top:350px;left:120px;display:none;">
          <span class="bubble-icon">✈</span>
          El sistema lee y estructura al instante los vuelos, fechas, escalas y horarios. ¡Sin cargarlos a mano!
        </div>

        <!-- Main Frame -->
        <div id="demo-frame" class="demo-app-frame zoom-phase-1">
            <!-- Sidebar -->
          <aside class="demo-sidebar">
            <div class="demo-sidebar-logo">
              <div class="demo-sidebar-logo-icon">✈</div>
              <div class="demo-sidebar-logo-text">Trip Conecta<br><span style="font-size:0.65rem;color:#64748b;font-weight:normal;">B2B System</span></div>
            </div>
            <div class="demo-menu-item">⊞ Dashboard</div>
            <div class="demo-menu-item">⬜ Catálogo</div>
            <div class="demo-menu-item active">📄 Cotizaciones</div>
            <div class="demo-menu-item">👥 Clientes</div>
            <div class="demo-menu-item">🛒 Mis Ventas</div>
            <div class="demo-menu-item">📁 Mis Documentos</div>
            <div style="margin-top:auto;">
              <div class="demo-menu-item">⚙ Configuración</div>
            </div>
          </aside>

          <!-- Main Content -->
          <main class="demo-main-content">
            <header class="demo-header">
              <div class="demo-search-bar">🔍 Buscar paquetes, ventas, clientes...</div>
              <div class="demo-header-right">
                <div class="demo-header-icon">🌙</div>
                <div class="demo-header-icon">🔔<span class="demo-notif-dot"></span></div>
                <div class="demo-user-profile">
                  <div style="text-align:right;">
                    <div style="color:white;font-size:0.85rem;font-weight:600;">Vendedor Test</div>
                    <div style="color:#94a3b8;font-size:0.7rem;">VENDEDOR</div>
                  </div>
                  <div class="demo-avatar">VE</div>
                </div>
              </div>
            </header>

            <div class="demo-content-body">
              <h1 class="demo-page-title">Nueva Cotización Manual</h1>
              <p class="demo-page-subtitle">Crea una cotización personalizada paso a paso</p>

              <div class="demo-stepper">
                <div class="demo-step completed">
                  <div class="demo-step-icon">✓</div> Cliente <span class="demo-step-sep">-</span>
                </div>
                <div class="demo-step active">
                  <div class="demo-step-icon">2</div> Vuelos <span class="demo-step-sep">-</span>
                </div>
                <div class="demo-step">
                  <div class="demo-step-icon">3</div> Hospedaje <span class="demo-step-sep">-</span>
                </div>
                <div class="demo-step">
                  <div class="demo-step-icon">4</div> Itinerario <span class="demo-step-sep">-</span>
                </div>
                <div class="demo-step">
                  <div class="demo-step-icon">5</div> Precios
                </div>
              </div>

              <div class="demo-tabs">
                <div class="demo-tab active">Pegar desde Amadeus</div>
                <div class="demo-tab">Ingresar Manual</div>
              </div>

              <div class="demo-box-container">
                <div class="demo-box-header">✦ Código Amadeus</div>
                <p id="demo-box-desc" class="demo-box-desc">Pega aquí el itinerario de Amadeus (formato RP/). El sistema detectará automáticamente los vuelos.</p>

                <div id="demo-inner-scroll" class="demo-inner-scroll-wrapper">
                  <div id="demo-amadeus-wrapper" class="demo-amadeus-input-wrapper">
                    <div id="demo-typed-code" class="demo-amadeus-code"></div>
                  </div>

                  <button id="demo-detect-btn" class="demo-detect-btn">
                    ✦ Detectar Vuelos Automáticamente
                  </button>

                  <div id="demo-flights-result" class="demo-flights-result" style="display:none;">
                    <div class="demo-flights-header">✓ 2 vuelo(s) detectado(s)</div>

                    <div class="demo-flight-card">
                      <div class="demo-flight-top">
                        <div class="demo-flight-number">UX 046</div>
                        <div class="demo-flight-class">Clase T</div>
                      </div>
                      <div class="demo-flight-route">
                        <div class="demo-flight-point">
                          <div class="demo-flight-code">MVD</div>
                          <div>12:20</div>
                          <div class="demo-flight-time">vie, 15 may</div>
                        </div>
                        <div class="demo-flight-line">✈</div>
                        <div class="demo-flight-point" style="text-align:right;">
                          <div class="demo-flight-code">MAD</div>
                          <div>05:10</div>
                          <div class="demo-flight-time">sáb, 16 may</div>
                        </div>
                      </div>
                    </div>

                    <div class="demo-flight-card" style="animation-delay:0.2s;">
                      <div class="demo-flight-top">
                        <div class="demo-flight-number">UX 045</div>
                        <div class="demo-flight-class">Clase N</div>
                      </div>
                      <div class="demo-flight-route">
                        <div class="demo-flight-point">
                          <div class="demo-flight-code">MAD</div>
                          <div>23:55</div>
                          <div class="demo-flight-time">dom, 31 may</div>
                        </div>
                        <div class="demo-flight-line">✈</div>
                        <div class="demo-flight-point" style="text-align:right;">
                          <div class="demo-flight-code">MVD</div>
                          <div>07:35</div>
                          <div class="demo-flight-time">lun, 01 jun</div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="demo-footer-actions">
              <button class="demo-btn-prev">← Anterior</button>
              <div style="color:#94a3b8;font-size:0.85rem;align-self:center;">Paso 2 de 5</div>
              <button id="demo-btn-next" class="demo-btn-next">Siguiente →</button>
