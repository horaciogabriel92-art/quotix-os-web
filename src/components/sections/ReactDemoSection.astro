<style>
/* ===================== DEMO ANIMATION STYLES ===================== */
.demo-app-wrapper {
  perspective: 1000px;
  width: 100%;
  height: 820px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.demo-app-frame {
  width: 1024px;
  height: 760px;
  background-color: #0b0f19;
  border-radius: 12px;
  box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
  display: flex;
  overflow: hidden;
