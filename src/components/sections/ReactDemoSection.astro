/* Bubbles */
.demo-bubble {
  position: absolute;
  background: linear-gradient(135deg, #2563eb, #1e40af);
  color: white; padding: 1rem 1.25rem; border-radius: 12px;
  font-size: 0.95rem; font-weight: 500;
  box-shadow: 0 10px 25px -5px rgba(37,99,235,0.5), 0 0 0 1px rgba(255,255,255,0.1) inset;
  z-index: 100; max-width: 280px; line-height: 1.4;
  opacity: 0; transform: translateY(20px) scale(0.95);
  animation: demoPopIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}
.demo-bubble::after {
  content: ''; position: absolute;
  width: 0; height: 0; border: 8px solid transparent;
}
.bubble-bottom::after {
  bottom: 100%; left: 50%; transform: translateX(-50%);
  border-bottom-color: #2563eb;
}
.bubble-right::after {
  right: 100%; top: 50%; transform: translateY(-50%);
  border-right-color: #2563eb;
}
.bubble-top::after {
  top: 100%; left: 50%; transform: translateX(-50%);
  border-top-color: #1e40af;
}
.bubble-icon {
  display: inline-flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.2); border-radius: 50%;
  width: 28px; height: 28px; margin-right: 8px; vertical-align: middle;
}
@keyframes demoPopIn { to { opacity: 1; transform: translateY(0) scale(1); } }

@keyframes demoBlink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }
.demo-cursor { animation: demoBlink 1s infinite; }
</style>

<script>
  // Astro processes <script> as ES modules which are deferred —
  // DOM is already ready when this runs, no need for DOMContentLoaded.
  function initDemoAnimation() {
    const PNR_TEXT = `RP/DZOUY2100/\n 1  UX 046 T 16MAY 6 MVDMAD DK1  1220 0510  17MAY  E  0 789 M\n    SEE RTSVC\n 2  UX 045 N 01JUN 1 MADMVD DK1  2355 0735  02JUN  E  0 789 M\n    SEE RTSVC`;

    let phase = 1;
    let mainTimeout = null;
    let typeInterval = null;
    let started = false;

    const frame         = document.getElementById('demo-frame');
    const typedCode     = document.getElementById('demo-typed-code');
    const detectBtn     = document.getElementById('demo-detect-btn');
    const flightsResult = document.getElementById('demo-flights-result');
    const amadeusWrapper= document.getElementById('demo-amadeus-wrapper');
    const innerScroll   = document.getElementById('demo-inner-scroll');
    const pdfOverlay    = document.getElementById('demo-pdf-overlay');
    const pdfDoc        = document.getElementById('demo-pdf-doc');
    const boxDesc       = document.getElementById('demo-box-desc');
    const bubble1       = document.getElementById('bubble-phase1');
    const bubble2       = document.getElementById('bubble-phase2');
    const pdfBubble     = document.getElementById('demo-pdf-bubble');
    const btnNext       = document.getElementById('demo-btn-next');

    // Guard: if any element is missing, bail out silently
    if (!frame || !typedCode || !detectBtn) return;

    function showBubble(el) {
      el.style.display = 'block';
      // Re-trigger pop-in animation
      el.style.animation = 'none';
      void el.offsetHeight;
      el.style.animation = 'demoPopIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards';
    }

    function hideBubble(el) {
      el.style.display = 'none';
    }

    function setPhase(p) {
      phase = p;
      const zoomClass = 'zoom-phase-' + Math.min(p, 3);
      frame.className = 'demo-app-frame ' + zoomClass;

      // Bubbles
      if (p === 1) { showBubble(bubble1); hideBubble(bubble2); hideBubble(pdfBubble); }
      else if (p === 2) { hideBubble(bubble1); showBubble(bubble2); hideBubble(pdfBubble); }
      else if (p === 3) { hideBubble(bubble1); hideBubble(bubble2); showBubble(pdfBubble); }
      else { hideBubble(bubble1); hideBubble(bubble2); hideBubble(pdfBubble); }

      // Next button pulse on phase 2
      if (p === 2) btnNext.classList.add('pulse');
      else btnNext.classList.remove('pulse');

      // Box description
      boxDesc.style.display = p === 1 ? 'block' : 'none';

      // Amadeus wrapper & scroll
      if (p > 1) {
        amadeusWrapper.classList.add('collapsed');
        innerScroll.classList.add('scrolled');
      } else {
        amadeusWrapper.classList.remove('collapsed');
        innerScroll.classList.remove('scrolled');
      }

      // Detect button state
      detectBtn.style.display = 'flex';
      if (p === 1) {
        detectBtn.className = 'demo-detect-btn';
        detectBtn.innerHTML = '✦ Detectar Vuelos Automáticamente';
      } else {
        detectBtn.className = 'demo-detect-btn done';
        detectBtn.innerHTML = '✦ Detectar Vuelos Automáticamente';
      }

      // Flights result
      if (p >= 2) {
        flightsResult.style.display = 'block';
        const cards = flightsResult.querySelectorAll('.demo-flight-card');
        cards.forEach(function(c, i) {
          c.style.animation = 'none';
          void c.offsetHeight;
          c.style.animation = 'demoFlyIn 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) ' + (i * 0.2) + 's forwards';
        });
      } else {
        flightsResult.style.display = 'none';
      }

      // PDF overlay
      if (p === 3) {
        pdfOverlay.classList.add('visible');
      } else {
        pdfOverlay.classList.remove('visible');
      }
    }

    function clearTimers() {
      if (mainTimeout) { clearTimeout(mainTimeout); mainTimeout = null; }
      if (typeInterval) { clearInterval(typeInterval); typeInterval = null; }
    }

    function runSequence() {
      clearTimers();

      // Full reset
      typedCode.innerHTML = '';
      pdfDoc.classList.remove('scrolling');
      setPhase(1);

      // Phase 1: type the PNR
      let charIndex = 0;
      typeInterval = setInterval(function () {
        if (charIndex <= PNR_TEXT.length) {
          const cursor = charIndex < PNR_TEXT.length
            ? '<span class="demo-cursor">|</span>' : '';
          typedCode.innerHTML = PNR_TEXT.substring(0, charIndex) + cursor;
          charIndex += 2;
        } else {
          clearInterval(typeInterval);
          typeInterval = null;

          // Show "Analizando GDS..." loading state
          detectBtn.className = 'demo-detect-btn loading';
          detectBtn.innerHTML = 'Analizando GDS...';

          // After 1s → show flights (phase 2)
          mainTimeout = setTimeout(function () {
            setPhase(2);

            // After 6s reading flights → open PDF (phase 3)
            mainTimeout = setTimeout(function () {
              setPhase(3);

              // After 2s → start PDF scroll
              mainTimeout = setTimeout(function () {
                pdfDoc.classList.add('scrolling');

                // After 14s scrolling → fade out and restart
                mainTimeout = setTimeout(function () {
                  setPhase(4); // hides overlay, resets classes
                  mainTimeout = setTimeout(runSequence, 800);
                }, 14000);
              }, 2000);
            }, 6000);
          }, 1000);
        }
      }, 45);
    }

    // Start animation when the section scrolls into view (lazy start)
    const root = document.getElementById('demo-animation-root');
    if (root && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && !started) {
            started = true;
            runSequence();
          }
        });
      }, { threshold: 0.1 });
      observer.observe(root);
    } else if (root) {
      // Fallback: start immediately
      runSequence();
    }
  } // end initDemoAnimation

  // Call directly — Astro module scripts are deferred, DOM is already ready
  initDemoAnimation();
</script>

