---
const pillars = [
  {
    icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
    title: "Cotiza",
    description: "Arma paquetes completos en minutos con nuestro cotizador inteligente. Vuelos, hoteles, traslados y actividades en un solo lugar."
  },
  {
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
    title: "Genera PDF",
    description: "PDFs profesionales con tu marca, listos para enviar al cliente. Incluye itinerario detallado, términos y condiciones, y datos de pago."
  },
  {
    icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    title: "Controla",
    description: "Dashboard de comisiones en tiempo real. Visualiza ganancias por vendedor, seguimiento de reservas y reportes de ventas."
  }
];
---

<section class="section-padding bg-[#0f172a] border-t border-slate-800/50">
  <div class="container-custom">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="heading-lg text-white mb-4">
        Cotizaciones turísticas simplificadas
      </h2>
      <p class="body-md text-slate-400">
        Todo lo que necesitas para vender más y mejor. Desde la primera consulta hasta el cierre de la venta.
      </p>
    </div>
    
    <!-- 3 Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {pillars.map((pillar, index) => (
        <div class="group relative p-6 lg:p-8 rounded-2xl bg-slate-800/30 border border-slate-700/50 hover:bg-slate-800/50 hover:border-slate-600/50 transition-all duration-300">
          <!-- Icon badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-gradient-to-r from-[#8b5cf6] to-[#bf3480] mb-5">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={pillar.icon}/></svg>
            <span class="text-xs font-semibold text-white tracking-wide">{pillar.title}</span>
          </div>
          
          <!-- Content -->
          <p class="text-sm text-slate-300 leading-relaxed">
            {pillar.description}
          </p>
          
          <!-- Hover indicator -->
          <div class="absolute bottom-0 left-6 right-6 h-0.5 bg-gradient-to-r from-[#bf3480] to-[#d4f542] rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </div>
      ))}
    </div>
  </div>
</section>
