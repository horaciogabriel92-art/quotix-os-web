---
---

<section class="section-padding bg-white border-t border-slate-100">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Left content -->
      <div class="max-w-lg">
        <span class="inline-block text-xs font-semibold text-[#bf3480] uppercase tracking-wider mb-3">Parser PNR Integrado</span>
        <h2 class="heading-lg text-slate-900 mb-4">
          Importa reservas de Amadeus en segundos
        </h2>
        <p class="body-md text-slate-600 mb-6 leading-relaxed">
          Pega el PNR de Amadeus y Quotix extrae automáticamente vuelos, horarios, aerolíneas y precios. Olvídate de copiar datos manualmente entre sistemas.
        </p>
        <ul class="space-y-3 mb-6">
          <li class="flex items-start gap-3">
            <div class="w-5 h-5 rounded-full bg-[#d4f542] flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-3 h-3 text-[#0f172a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-sm text-slate-600">Extracción automática de itinerarios</span>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-5 h-5 rounded-full bg-[#d4f542] flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-3 h-3 text-[#0f172a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-sm text-slate-600">Cálculo automático de tarifas y tasas</span>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-5 h-5 rounded-full bg-[#d4f542] flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-3 h-3 text-[#0f172a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-sm text-slate-600">Detección de clases y restricciones</span>
          </li>
        </ul>
        <a href="#" class="inline-flex items-center gap-2 text-sm font-semibold text-[#bf3480] hover:text-[#d9469a] transition-colors group">
          Ver cómo funciona
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
      
      <!-- Right - UI Mockup -->
      <div class="relative">
        <!-- Gradient border effect -->
        <div class="absolute -inset-0.5 bg-gradient-to-r from-[#bf3480] to-[#8b5cf6] rounded-2xl opacity-20 blur-sm"></div>
        
        <div class="relative rounded-2xl overflow-hidden bg-white shadow-xl shadow-slate-200/50 border border-slate-100">
          <!-- Header -->
          <div class="px-5 py-4 border-b border-slate-100 flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-gradient-to-r from-[#bf3480] to-[#8b5cf6] flex items-center justify-center">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <div>
              <div class="text-sm font-semibold text-slate-900">Importar PNR</div>
              <div class="text-xs text-slate-500">Amadeus · AA6X7K</div>
            </div>
          </div>
          
          <!-- Content -->
          <div class="p-5 space-y-4">
            <!-- PNR Input -->
            <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 font-mono text-xs text-slate-600">
              <div>1.1GARCIA/MARIA MR</div>
              <div>2. AA 1234 Y 15DEC MEXCUN HK1 0800 0945</div>
              <div>3. AA 5678 Y 22DEC CUNMEX HK1 1130 1315</div>
            </div>
            
            <!-- Parsed Result -->
            <div class="pt-2">
              <div class="text-xs font-medium text-slate-900 uppercase tracking-wide mb-2">Datos extraídos</div>
              <div class="space-y-2">
                <div class="flex items-center gap-2 p-2.5 bg-green-50 rounded-lg border border-green-100">
                  <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span class="text-sm text-slate-700">Vuelo de ida: AA1234 · 15 Dic · 08:00</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 bg-green-50 rounded-lg border border-green-100">
                  <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span class="text-sm text-slate-700">Vuelo vuelta: AA5678 · 22 Dic · 11:30</span>
                </div>
              </div>
            </div>
            
            <!-- Action -->
            <div class="flex gap-2 pt-2">
              <button class="flex-1 py-2 text-xs font-medium text-white bg-[#0f172a] rounded-lg hover:bg-[#1e293b] transition-colors">
                Crear cotización
              </button>
            </div>
          </div>
        </div>
        
        <!-- Decorative elements -->
        <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-gradient-to-br from-[#d4f542]/20 to-transparent rounded-full blur-xl"></div>
      </div>
    </div>
  </div>
</section>
