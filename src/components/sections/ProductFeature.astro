<section class="py-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left content -->
      <div>
        <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-4">Quotix AI</p>
        <h2 class="text-3xl sm:text-4xl font-semibold text-slate-900 mb-6 leading-tight">
          Resolve up to 70% of requests with AI, not just the low-hanging fruit
        </h2>
        <p class="text-lg text-slate-600 mb-8 leading-relaxed">
          Quotix AI takes on complex requests others escalate by automating responses, assisting teams, and analyzing quality across your entire operation. Every reply improves with each conversation.
        </p>
        <a href="#" class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white bg-[#bf3480] rounded-full btn-magenta">
          Learn more
        </a>
      </div>
      
      <!-- Right image/visual -->
      <div class="relative">
        <div class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-[#bf3480] to-[#e879ab] p-1">
          <div class="bg-white rounded-xl p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-[#bf3480]/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-[#bf3480]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <div>
                <div class="font-semibold text-slate-900">Autopilot</div>
                <div class="text-sm text-slate-500">To: Cameron Meyer</div>
              </div>
            </div>
            <div class="space-y-3">
              <div class="p-3 bg-slate-50 rounded-lg">
                <div class="text-sm text-slate-600">Hi Cameron,</div>
              </div>
              <div class="p-3 bg-slate-50 rounded-lg border-l-4 border-[#bf3480]">
                <div class="text-sm text-slate-700">
                  <span class="font-semibold">Mark Turner</span> asked about if their product is under warranty after battery issues.
                </div>
              </div>
              <div class="text-sm font-medium text-slate-900">Knowledge sources</div>
              <div class="flex items-center gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Does my warranty cover battery...
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
