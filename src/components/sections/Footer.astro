---
import Logo from '@/components/ui/Logo.astro';

const columns = [
  { 
    title: "Producto", 
    links: [
      { label: "Funcionalidades", href: "/funcionalidades" },
      { label: "Conversor PNR", href: "/pnr-converter" },
      { label: "Cotizador PDF", href: "/cotizador-pdf-agencias-viajes" },
      { label: "CRM", href: "/crm-agencias-viajes" },
      { label: "Web de paquetes", href: "/web-paquetes-turisticos" },
      { label: "Precios", href: "/precios" },
    ] 
  },
  { 
    title: "Recursos", 
    links: [
      { label: "Blog", href: "/blog" },
      { label: "¿Qué es un PNR?", href: "/blog/que-es-pnr" },
      { label: "Cómo leer PNR", href: "/blog/como-leer-pnr-amadeus" },
      { label: "Comparativas", href: "/blog/mejores-software-agencias-viajes" },
    ] 
  },
  { 
    title: "Empresa", 
    links: [
      { label: "Sobre nosotros", href: "/sobre-nosotros" },
      { label: "Contacto", href: "/contacto" },
      { label: "Casos de éxito", href: "/casos-de-exito" },
    ] 
  },
  { 
    title: "Legal", 
    links: [
      { label: "Privacidad", href: "/privacidad" },
      { label: "Términos", href: "/terminos" },
      { label: "Cookies", href: "/cookies" },
    ] 
  }
];

const countries = ["México", "Colombia", "Argentina", "Chile", "Uruguay", "España", "Perú", "Brasil"];
---

<footer class="bg-[#0a0f1c] pt-16 pb-8">

  <!-- Countries ticker -->
  <div class="overflow-hidden mb-12 border-t border-b border-slate-800/60 py-5">
    <div class="ticker-track flex gap-12 whitespace-nowrap opacity-30">
      {[...countries, ...countries].map(c => (
        <span class="text-lg font-bold text-white">{c}</span>
      ))}
    </div>
  </div>

  <!-- Main content -->
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-6 gap-10 lg:gap-8 mb-12">

      <!-- Logo + Tagline + Contact -->
      <div class="lg:col-span-2">
        <Logo variant="blanco" width={140} />
        <p class="text-base font-medium text-white/80 mt-4 leading-snug mb-5">
          El sistema operativo de tu agencia de viajes
        </p>
        <div class="space-y-2">
          <a href="mailto:hola@quotixos.com" class="flex items-center gap-2 text-sm text-white/50 hover:text-[#bf3480] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            hola@quotixos.com
          </a>
          <a href="tel:+59899123456" class="flex items-center gap-2 text-sm text-white/50 hover:text-[#bf3480] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            +598 99 123 456
          </a>
        </div>
        <!-- Social -->
        <div class="flex gap-3 mt-5">
          {[
            { label: "LinkedIn", href: "https://www.linkedin.com/company/quotix", path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" },
            { label: "X", href: "https://x.com/quotixos", path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" },
            { label: "Instagram", href: "https://www.instagram.com/quotixos", path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" }
          ].map(s => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-[#bf3480] hover:scale-110 transition-all duration-200">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={s.path}/></svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Nav columns -->
      {columns.map(col => (
        <div>
          <h3 class="text-xs font-semibold text-white/40 uppercase tracking-wider mb-4">{col.title}</h3>
          <ul class="space-y-2.5">
            {col.links.map(link => (
              <li>
                <a href={link.href} class="text-sm text-white/70 hover:text-[#bf3480] transition-colors duration-200 relative group">
                  {link.label}
                  <span class="absolute bottom-0 left-0 w-0 h-px bg-[#bf3480] group-hover:w-full transition-all duration-250"></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-white/30">© 2025 Quotix. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="/privacidad" class="text-xs text-white/30 hover:text-white/60 transition-colors">Privacidad</a>
        <a href="/terminos" class="text-xs text-white/30 hover:text-white/60 transition-colors">Términos</a>
        <a href="/cookies" class="text-xs text-white/30 hover:text-white/60 transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>

<style>
@keyframes ticker {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.ticker-track { animation: ticker 30s linear infinite; }
</style>
