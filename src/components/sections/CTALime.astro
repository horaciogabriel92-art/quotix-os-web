---
---

<section class="py-24 bg-[#0f172a]">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      <!-- Left - Lime box -->
      <div class="p-12 rounded-3xl bg-[#d4f542] flex flex-col justify-center">
        <h2 class="text-3xl sm:text-4xl font-semibold text-[#0f172a] mb-8 leading-tight">
          Ready to tame the insanity? Come to Quotix.
        </h2>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#demo" class="inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold text-white bg-[#0f172a] rounded-full hover:bg-[#1e293b] transition-all">
            Request a demo
          </a>
          <a href="#free" class="inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold text-[#0f172a] border-2 border-[#0f172a] rounded-full hover:bg-[#0f172a]/10 transition-all">
            Try for free
          </a>
        </div>
      </div>
      
      <!-- Right - Image with notification -->
      <div class="relative rounded-3xl overflow-hidden">
        <div class="aspect-[4/3] bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center">
          <div class="text-center p-8">
            <div class="w-24 h-24 mx-auto mb-4 rounded-full bg-[#bf3480]/20 flex items-center justify-center">
              <svg class="w-12 h-12 text-[#bf3480]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <p class="text-slate-300">Team productivity</p>
          </div>
        </div>
        
        <!-- Floating notification -->
        <div class="absolute bottom-6 left-6 right-6 bg-white rounded-xl p-4 shadow-xl">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div class="text-sm">
              <span class="font-medium text-slate-900">Sophia</span> marked this ticket as <span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-medium">Resolved</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
