---
const stats = [
  { value: 40, suffix: "+", label: "agencias activas" },
  { value: 12000, suffix: "+", label: "cotizaciones este mes" },
  { value: 93, suffix: "%", label: "retención anual" },
  { value: 4.9, suffix: "", label: "rating promedio" }
];
const logos = ["Viajes del Sur", "TurTravel", "Nexo Viajes", "AeroTur", "LatinPass"];
---

<section class="section-padding bg-slate-50">
  <div class="container-custom">

    <!-- Logo row -->
    <div class="text-center mb-14 reveal">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-6">Agencias que ya cotizan más rápido</p>
      <div class="flex flex-wrap justify-center gap-8 lg:gap-12 items-center opacity-40">
        {logos.map((logo, i) => (
          <span class="logo-item text-lg font-bold text-slate-700 opacity-0 transition-all duration-400" style={`transition-delay: ${i * 0.1}s`}>
            {logo}
          </span>
        ))}
      </div>
    </div>

    <!-- Testimonial -->
    <div class="max-w-3xl mx-auto mb-16 reveal">
      <div class="relative p-8 lg:p-12 rounded-2xl bg-white border border-slate-100 shadow-lg shadow-slate-200/50">
        <!-- Big quote mark -->
        <div class="absolute top-6 left-8 text-8xl text-[#bf3480]/10 font-serif leading-none select-none">"</div>
        <blockquote class="relative text-lg lg:text-xl text-slate-700 leading-relaxed mb-6 pt-6">
          Pasamos de 12 cotizaciones por día a 40. El equipo está feliz porque no pasan horas en Excel. Y yo estoy feliz porque vendemos más.
        </blockquote>
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-[#bf3480]/10 flex items-center justify-center text-[#bf3480] font-bold">MG</div>
          <div>
            <div class="font-semibold text-slate-900">María García</div>
            <div class="text-sm text-slate-500">Directora de Operaciones, Viajes del Sur</div>
          </div>
          <div class="ml-auto flex gap-1">
            {[1,2,3,4,5].map(() => <span class="text-[#d4f542]">★</span>)}
          </div>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
      {stats.map((stat, i) => (
        <div class="stat-card text-center p-6 rounded-2xl bg-white border border-slate-100 shadow-sm opacity-0" style={`transition-delay: ${i * 0.15}s`}>
          <div class="text-3xl lg:text-4xl font-bold text-slate-900 mb-1">
            <span class="stat-num" data-value={stat.value} data-suffix={stat.suffix}>0{stat.suffix}</span>
          </div>
          <div class="text-sm text-slate-500">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.stat-card { transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1), transform 0.6s cubic-bezier(0.25, 1, 0.5, 1); transform: translateY(20px); }
.stat-card.active { opacity: 1; transform: translateY(0); }
.logo-item.active { opacity: 1; }
</style>

<script>
  (function() {
    function animateNum(el) {
      const target = parseFloat(el.dataset.value);
      const suffix = el.dataset.suffix || '';
      const isDecimal = target % 1 !== 0;
      const duration = 1800;
      const frames = 60;
      let frame = 0;
      const timer = setInterval(() => {
        frame++;
        const progress = frame / frames;
        const ease = 1 - Math.pow(1 - progress, 3);
        const current = target * ease;
        el.textContent = (isDecimal ? current.toFixed(1) : Math.floor(current)) + suffix;
        if (frame >= frames) { el.textContent = (isDecimal ? target.toFixed(1) : target) + suffix; clearInterval(timer); }
      }, duration / frames);
    }

    // Stats
    const statCards = document.querySelectorAll('.stat-card');
    const statsObs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          statCards.forEach((c, i) => {
            setTimeout(() => {
              c.classList.add('active');
              const num = c.querySelector('.stat-num');
              if (num) animateNum(num);
            }, i * 150);
          });
          statsObs.disconnect();
        }
      });
    }, { threshold: 0.2 });
    if (statCards[0]) statsObs.observe(statCards[0]);

    // Logos
    const logoItems = document.querySelectorAll('.logo-item');
    const logoObs = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        logoItems.forEach((l, i) => setTimeout(() => l.classList.add('active'), i * 100));
        logoObs.disconnect();
      }
    }, { threshold: 0.3 });
    if (logoItems[0]) logoObs.observe(logoItems[0]);

    // Reveals
    document.querySelectorAll('.reveal').forEach(el => {
      el.style.opacity = '0'; el.style.transform = 'translateY(30px)';
      el.style.transition = 'all 0.6s cubic-bezier(0.25, 1, 0.5, 1)';
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) { el.style.opacity = '1'; el.style.transform = 'none'; }
      }, { threshold: 0.2 }).observe(el);
    });
  })();
</script>
