---
import TenantLayout from '@/layouts/TenantLayout.astro';
import CotizacionForm from '@/components/tenant/CotizacionForm';
import { API_URL } from '@/lib/publicApi';

export async function getStaticPaths() {
  try {
    const res = await fetch(`${API_URL}/public/landings`);
    const data = await res.json();
    const slugs = data.slugs || [];
    const paths: any[] = [];
    for (const slug of slugs) {
      try {
        const landingRes = await fetch(`${API_URL}/public/landing/${slug}`);
        if (!landingRes.ok) continue;
        const landingData = await landingRes.json();
        for (const p of landingData.paquetes || []) {
          paths.push({ params: { slug, id: p.id } });
        }
      } catch (e) {
        console.error(`[landing] Error fetching ${slug}:`, e);
      }
    }
    return paths;
  } catch (err) {
    console.error('[landing] Error generating static paths:', err);
    return [];
  }
}

const { slug, id } = Astro.params;
let data: any = null;
let error = '';

try {
  const res = await fetch(`${API_URL}/public/landing/${slug}/paquetes/${id}`);
  if (!res.ok) throw new Error('Paquete no encontrado');
  data = await res.json();
} catch (err: any) {
  error = err.message || 'Error al cargar el paquete';
}

if (error || !data) {
  return new Response(
    `<!DOCTYPE html><html><head><meta charset="utf-8"><title>No encontrado</title></head><body><h1>${error || 'Paquete no encontrado'}</h1></body></html>`,
    { status: 404, headers: { 'Content-Type': 'text/html' } }
  );
}

const { tenant, landing, paquete } = data;
const imagen = paquete.imagen_url || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800';

const title = landing.seo?.title || `${paquete.titulo} — ${landing.titulo || tenant.nombre}`;
const description = landing.seo?.description || paquete.descripcion?.slice(0, 160) || `Paquete ${paquete.titulo} en ${paquete.destino}`;

const dias = Array.isArray(paquete.itinerario?.dias)
  ? paquete.itinerario.dias
  : [];
---

<TenantLayout tenant={tenant} landing={landing} title={title} description={description} canonical={`/${slug}/paquetes/${id}/`}>
  <!-- Hero del paquete -->
  <section class="border-b" style="background-color: var(--brand-bg); border-color: rgba(0,0,0,0.06);">
    <div class="container-custom mx-auto px-6 py-10 md:py-16">
      <div class="flex flex-wrap items-center gap-2 text-sm opacity-60 mb-4">
        <a href={`/${slug}/`} class="hover:underline">Inicio</a>
        <span>/</span>
        <span>{paquete.destino}</span>
      </div>

      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div class="rounded-2xl overflow-hidden border border-black/10 shadow-sm">
          <img src={imagen} alt={paquete.titulo} class="w-full h-72 md:h-96 object-cover" />
        </div>
        <div>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="px-3 py-1 rounded-full text-xs font-semibold text-white" style={`background-color: var(--brand-primary);`}>
              {paquete.duracion} días
            </span>
            {paquete.fecha_salida && (
              <span class="px-3 py-1 rounded-full text-xs font-semibold bg-black/5">
                Salida: {new Date(paquete.fecha_salida).toLocaleDateString('es-AR')}
              </span>
            )}
          </div>
          <h1 class="heading-lg mb-4" style="color: var(--brand-text);">{paquete.titulo}</h1>
          <p class="body-md opacity-70 mb-6">{paquete.destino}</p>

          {landing.mostrar_precios !== false && (
            <div class="mb-8">
              <p class="text-sm opacity-60 mb-1">Desde</p>
              <p class="text-3xl font-bold" style={`color: var(--brand-primary);`}>
                ${Number(paquete.precio_doble || paquete.precio_base || 0).toLocaleString('es-AR')} <span class="text-base font-normal opacity-60">por persona</span>
              </p>
            </div>
          )}

          {landing.whatsapp && (
            <a
              href={`https://wa.me/${landing.whatsapp.replace(/\D/g, '')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 font-semibold px-6 py-3 rounded-full text-white transition-opacity hover:opacity-90"
              style={`background-color: var(--brand-primary);`}
            >
              Consultar por WhatsApp
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Contenido principal -->
  <section class="container-custom mx-auto px-6 py-16" style="background-color: var(--brand-bg);">
    <div class="grid lg:grid-cols-3 gap-10">
      <!-- Columna izquierda: detalles -->
      <div class="lg:col-span-2 space-y-10">
        {paquete.descripcion && (
          <div class="bg-white rounded-2xl border border-black/10 p-6 md:p-8">
            <h2 class="heading-sm mb-4" style="color: var(--brand-text);">Descripción</h2>
            <p class="opacity-70 whitespace-pre-line">{paquete.descripcion}</p>
          </div>
        )}

        {paquete.incluye?.length > 0 && (
          <div class="bg-white rounded-2xl border border-black/10 p-6 md:p-8">
            <h2 class="heading-sm mb-4" style="color: var(--brand-text);">Incluye</h2>
            <ul class="grid sm:grid-cols-2 gap-3">
              {paquete.incluye.map((item: string) => (
                <li key={item} class="flex items-start gap-2 text-sm opacity-80">
                  <span class="mt-0.5 w-1.5 h-1.5 rounded-full flex-shrink-0" style={`background-color: var(--brand-primary);`}></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        )}

        {paquete.no_incluye?.length > 0 && (
          <div class="bg-white rounded-2xl border border-black/10 p-6 md:p-8">
            <h2 class="heading-sm mb-4" style="color: var(--brand-text);">No incluye</h2>
            <ul class="grid sm:grid-cols-2 gap-3">
              {paquete.no_incluye.map((item: string) => (
                <li key={item} class="flex items-start gap-2 text-sm opacity-80">
                  <span class="mt-0.5 w-1.5 h-1.5 rounded-full flex-shrink-0 bg-red-400"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        )}

        {dias.length > 0 && (
          <div class="bg-white rounded-2xl border border-black/10 p-6 md:p-8">
            <h2 class="heading-sm mb-6" style="color: var(--brand-text);">Itinerario</h2>
            <div class="space-y-6">
              {dias.map((dia: any, idx: number) => (
                <div key={idx} class="flex gap-4">
                  <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center text-white text-sm font-bold" style={`background-color: var(--brand-primary);`}>
                    {idx + 1}
                  </div>
                  <div>
                    <h3 class="font-semibold text-sm" style="color: var(--brand-text);">{dia.titulo || `Día ${idx + 1}`}</h3>
                    <p class="text-sm opacity-70 mt-1">{dia.descripcion || ''}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Columna derecha: formulario -->
      <div class="lg:col-span-1">
        <div class="sticky top-24">
          <CotizacionForm slug={slug} paqueteId={id} paqueteNombre={paquete.titulo} landing={landing} client:load />
        </div>
      </div>
    </div>
  </section>
</TenantLayout>
