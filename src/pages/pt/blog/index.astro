---
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';

const title = 'Blog da Quotix | Software, PNR e Cotações para Agências de Viagem';
const description = 'Guias práticos para agências de viagens: PNR Amadeus, cotações em PDF, software de gestão e melhores práticas para vender mais viagens.';
const canonical = '/pt/blog/';

const posts = [
  {
    slug: '/pt/blog/o-que-e-pnr/',
    title: 'O que é um PNR? Guia Completo para Agentes de Viagem 2026',
    excerpt: 'Descubra o que é um Passenger Name Record, como é estruturado na Amadeus e por que você não deve enviá-lo em bruto aos seus clientes.',
    image: '/images/blog/boarding-pass.jpg',
    category: 'Guia PNR',
    date: '21 jul 2026',
    readTime: '8 min'
  },
  {
    slug: '/pt/blog/pnr-converter-vs-quotix/',
    title: 'PNR Converter vs Quotix: Qual Escolher para sua Agência?',
    excerpt: 'Comparativo honesto entre PNR Converter gratuito e Quotix. Descubra qual convém segundo o tamanho da sua agência e por quê.',
    image: '/images/blog/flight-screen.jpg',
    category: 'Comparativos',
    date: '21 jul 2026',
    readTime: '10 min'
  },
  {
    slug: '/pt/blog/melhores-software-agencias-viagem/',
    title: 'Melhores Software para Agências de Viagem na LATAM 2026',
    excerpt: 'Comparativa dos principais software para agências de viagem: funcionalidades, preços e recomendação segundo o tamanho da sua agência.',
    image: '/images/blog/travel-counters.jpg',
    category: 'Comparativos',
    date: '21 jul 2026',
    readTime: '11 min'
  },
  {
    slug: '/pt/blog/calcular-comissoes-pnr/',
    title: 'Como Calcular Comissões a partir de um PNR sem Erros',
    excerpt: 'Aprenda a ler os campos de comissão de um PNR da Amadeus, aplicar markup corretamente e proteger a margem da sua agência.',
    image: '/images/blog/travel-counters.jpg',
    category: 'Negócios',
    date: '21 jul 2026',
    readTime: '10 min'
  },
  {
    slug: '/pt/blog/converter-pnr-pdf/',
    title: 'Como Converter um PNR para PDF Profissional em 3 Passos',
    excerpt: 'Converta um PNR da Amadeus em um PDF profissional pronto para enviar. Economize tempo, evite erros de transcrição e venda mais viagens.',
    image: '/images/blog/airport-checkin.jpg',
    category: 'Tutorial PNR',
    date: '21 jul 2026',
    readTime: '9 min'
  },
  {
    slug: '/pt/blog/como-ler-pnr-amadeus/',
    title: 'Como Ler um PNR da Amadeus Passo a Passo | Guia 2026',
    excerpt: 'Aprenda a interpretar o formato enigmático da Amadeus: itinerários, códigos de status, prazos limite e campos de nome.',
    image: '/images/blog/flight-screen.jpg',
    category: 'Tutorial PNR',
    date: '21 jul 2026',
    readTime: '10 min'
  }
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog da Quotix',
  url: 'https://www.quotixos.com/pt/blog/',
  description: description,
  blogPost: posts.map(post => ({
    '@type': 'BlogPosting',
    headline: post.title,
    url: `https://www.quotixos.com${post.slug}`,
    datePublished: '2026-07-21',
    author: {
      '@type': 'Person',
      name: 'Horacio'
    }
  }))
});
---

<MainLayout title={title} description={description} canonical={canonical} schema={schema}>
  <Header />

  <main class="pt-24 pb-16 bg-slate-50 min-h-screen">
    <div class="container-custom max-w-5xl mx-auto">
      <div class="max-w-3xl mb-12">
        <span class="inline-block px-3 py-1 text-xs font-semibold tracking-wide text-magenta bg-magenta/10 rounded-full mb-4">
          Blog
        </span>
        <h1 class="heading-lg text-slate-900 mb-4">Blog da Quotix</h1>
        <p class="body-lg text-slate-600">
          Guias práticos para agências de viagens: PNR Amadeus, cotações em PDF, software de gestão e melhores práticas para vender mais viagens.
        </p>
      </div>

      <div class="grid gap-8">
        {posts.map(post => (
          <article class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <div class="grid md:grid-cols-[300px_1fr] gap-0">
              <a href={post.slug} class="block h-48 md:h-full overflow-hidden">
                <img src={post.image} alt={post.title} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
              </a>
              <div class="p-6 md:p-8">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
                  <span class="text-xs font-semibold text-magenta uppercase tracking-wide">{post.category}</span>
                  <span class="text-sm text-slate-400">{post.date} • {post.readTime}</span>
                </div>
                <h2 class="heading-sm text-slate-900 mb-3">
                  <a href={post.slug} class="hover:text-magenta transition-colors">{post.title}</a>
                </h2>
                <p class="text-slate-600 mb-4 leading-relaxed">{post.excerpt}</p>
                <a href={post.slug} class="inline-flex items-center text-sm font-semibold text-magenta hover:text-magenta-500 transition-colors">
                  Ler artigo
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</MainLayout>