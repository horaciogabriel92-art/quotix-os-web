---
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';

const title = 'Quotix — Sistema de ventas para agencias de viajes';
const description = 'Cotizaciones en 5 min, marketplace de paquetes y CRM integrado para agencias de viajes.';
const canonical = '/marketplace-cotizador-agencias-viajes/';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Quotix',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: description,
  url: 'https://www.quotixos.com/marketplace-cotizador-agencias-viajes/',
  brand: { '@type': 'Brand', name: 'Quotix' },
  inLanguage: 'es'
});
---

<MainLayout title={title} description={description} canonical={canonical} schema={schema}>
  <Fragment slot="head">
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "xt9die8gg7");
    </script>
  </Fragment>

  <Header />

  <main class="ql-page">
    <!-- SECCIÓN 1: HERO -->
    <section class="ql-hero" id="hero">
      <div class="ql-hero-bg" aria-hidden="true">
        <div class="ql-grid"></div>
      </div>
      <div class="ql-container ql-hero-inner">
        <div class="ql-logo">Quotix</div>
        <h1 class="ql-hero-title">¿Tu agencia vende viajes o administra caos?</h1>
        <p class="ql-hero-subtitle">
          Las agencias que usan Quotix cotizan en 5 min, captan leads automático y cierran más ventas sin perder nada en el camino.
        </p>
        <div class="ql-hero-ctas">
          <a href="/precios" class="ql-btn ql-btn-primary">Ver planes →</a>
          <a href="/precios" class="ql-btn ql-btn-secondary">Ver demo gratis</a>
        </div>
        <p class="ql-hero-micro">⚡ Setup en 10 min. Sin tarjeta. 7 días gratis.</p>
      </div>
    </section>

    <!-- SECCIÓN 2: EL PROBLEMA -->
    <section class="ql-section ql-section-dark" id="problema">
      <div class="ql-container">
        <h2 class="ql-section-title reveal">Hoy tu día se pierde en...</h2>
        <div class="ql-problem-grid">
          <article class="ql-card reveal" style="transition-delay: 0.1s;">
            <div class="ql-card-icon">📝</div>
            <h3>40 min por presupuesto</h3>
            <p>Word. Excel. Copiar y pegar. Tu marca no se ve profesional.</p>
          </article>
          <article class="ql-card reveal" style="transition-delay: 0.2s;">
            <div class="ql-card-icon">📱</div>
            <h3>WhatsApp explotado</h3>
            <p>¿Cuánto sale a Madrid? ¿Y con hotel? Respondés lo mismo 20 veces.</p>
          </article>
          <article class="ql-card reveal" style="transition-delay: 0.3s;">
            <div class="ql-card-icon">😵‍💫</div>
            <h3>Clientes perdidos</h3>
            <p>El lead quedó en el chat. Te olvidaste de seguirlo. La venta se fue a otro lado.</p>
          </article>
        </div>
        <p class="ql-problem-close reveal">Esto no es vender. Es sobrevivir.</p>
      </div>
    </section>

    <!-- SECCIÓN 3: EL FLUJO -->
    <section class="ql-section ql-section-alt" id="flujo">
      <div class="ql-container">
        <h2 class="ql-section-title reveal">Quotix conecta todo en un solo sistema</h2>

        <div class="ql-flow">
          <svg class="ql-flow-line desktop" viewBox="0 0 1100 80" preserveAspectRatio="none" aria-hidden="true">
            <path d="M 60 40 L 1040 40" fill="none" stroke="#bf3480" stroke-width="2" stroke-dasharray="1000" stroke-dashoffset="1000"/>
          </svg>
          <svg class="ql-flow-line mobile" viewBox="0 0 80 460" preserveAspectRatio="none" aria-hidden="true">
            <path d="M 40 30 L 40 430" fill="none" stroke="#bf3480" stroke-width="2" stroke-dasharray="500" stroke-dashoffset="500"/>
          </svg>

          <div class="ql-flow-grid">
            <div class="ql-flow-step reveal" style="transition-delay: 0.1s;">
              <div class="ql-flow-circle">👤</div>
              <h3>Cliente entra</h3>
              <p>Desde tu web o redes</p>
            </div>
            <div class="ql-flow-step reveal" style="transition-delay: 0.25s;">
              <div class="ql-flow-circle">📦</div>
              <h3>Elige paquete</h3>
              <p>Tu catálogo, tus precios</p>
            </div>
            <div class="ql-flow-step reveal" style="transition-delay: 0.4s;">
              <div class="ql-flow-circle">📄</div>
              <h3>Cotiza</h3>
              <p>PDF profesional con tu marca</p>
            </div>
            <div class="ql-flow-step reveal" style="transition-delay: 0.55s;">
              <div class="ql-flow-circle">📥</div>
              <h3>Deja datos</h3>
              <p>Lead capturado</p>
            </div>
            <div class="ql-flow-step reveal" style="transition-delay: 0.7s;">
              <div class="ql-flow-circle">👨‍💼</div>
              <h3>Llega al CRM</h3>
              <p>Todo organizado</p>
            </div>
            <div class="ql-flow-step reveal" style="transition-delay: 0.85s;">
              <div class="ql-flow-circle">💰</div>
              <h3>Vos cerrás</h3>
              <p>Seguimiento hasta el pago</p>
            </div>
          </div>
        </div>

        <p class="ql-flow-tagline reveal">Un recorrido. Sin fugas.</p>
      </div>
    </section>

    <!-- SECCIÓN 4: LOS 3 PILARES -->
    <section class="ql-section ql-section-dark" id="pilares">
      <div class="ql-container">
        <h2 class="ql-section-title reveal">Un sistema. Tres herramientas.</h2>
        <p class="ql-section-subtitle reveal">Cada una resuelve lo que te quema tiempo hoy:</p>

        <div class="ql-pillars-grid">
          <article class="ql-pillar reveal" style="transition-delay: 0.1s;">
            <span class="ql-pillar-number">01</span>
            <h3>Cotizador</h3>
            <p class="ql-pillar-hook">De 40 min a 5 min por presupuesto.</p>
            <ul>
              <li>Copiás datos de Amadeus</li>
              <li>O cargás todo desde cero</li>
              <li>PDF con tu logo y colores</li>
              <li>Comisiones claras</li>
            </ul>
            <a href="/cotizador-pdf-agencias-viajes" class="ql-pillar-link">Ver comparación PDF →</a>
          </article>

          <article class="ql-pillar reveal" style="transition-delay: 0.2s;">
            <span class="ql-pillar-number">02</span>
            <h3>Marketplace</h3>
            <p class="ql-pillar-hook">Tu catálogo como tienda online, sin programar.</p>
            <ul>
              <li>Cargás paquetes con fotos</li>
              <li>Quotix arma tu landing</li>
              <li>Link para web/bio/WhatsApp</li>
              <li>El cliente cotiza solo</li>
            </ul>
            <a href="/web-paquetes-turisticos" class="ql-pillar-link">Ver ejemplo de catálogo →</a>
          </article>

          <article class="ql-pillar reveal" style="transition-delay: 0.3s;">
            <span class="ql-pillar-number">03</span>
            <h3>CRM</h3>
            <p class="ql-pillar-hook">Ningún lead se pierde. Ningún seguimiento se olvida.</p>
            <ul>
              <li>Leads desde marketplace</li>
              <li>Estados: nuevo → vendido</li>
              <li>Pagos y saldos</li>
              <li>Recordatorios automáticos</li>
            </ul>
            <a href="/crm-agencias-viajes" class="ql-pillar-link">Ver panel de CRM →</a>
          </article>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 5: SOCIAL PROOF -->
    <section class="ql-section ql-section-dark" id="social">
      <div class="ql-container">
        <h2 class="ql-section-title reveal">Agencias que ya dejaron de perder tiempo</h2>

        <div class="ql-testimonials">
          <article class="ql-testimonial reveal" style="transition-delay: 0.1s;">
            <span class="ql-quote" aria-hidden="true">"</span>
            <p>Pasamos de mandar presupuestos en Word a PDFs con la marca de la agencia en minutos.</p>
            <footer>Operadora turística, Buenos Aires</footer>
          </article>
          <article class="ql-testimonial reveal" style="transition-delay: 0.2s;">
            <span class="ql-quote" aria-hidden="true">"</span>
            <p>El marketplace nos trae leads sin que tengamos que estar preguntando precios por WhatsApp todo el día.</p>
            <footer>Agencia de viajes, México</footer>
          </article>
          <article class="ql-testimonial reveal" style="transition-delay: 0.3s;">
            <span class="ql-quote" aria-hidden="true">"</span>
            <p>El CRM nos permite saber en qué está cada cotización. No volvimos a perder una venta.</p>
            <footer>Agencia familiar, Colombia</footer>
          </article>
        </div>

        <div class="ql-stats reveal">
          <div class="ql-stat">
            <div class="ql-stat-number" data-target="150" data-suffix="+">0</div>
            <div class="ql-stat-label">Agencias</div>
          </div>
          <div class="ql-stat">
            <div class="ql-stat-number" data-target="12" data-suffix="">0</div>
            <div class="ql-stat-label">Países</div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 6: PRECIOS -->
    <section class="ql-section ql-section-gradient" id="precios">
      <div class="ql-container">
        <h2 class="ql-section-title reveal">Empezá gratis. Escalá cuando crezcas.</h2>

        <div class="ql-pricing-grid">
          <article class="ql-pricing-card reveal" style="transition-delay: 0.1s;">
            <h3>Inicial</h3>
            <div class="ql-price">$XX<span>/mes</span></div>
            <ul class="ql-features">
              <li class="yes">Cotizador PDF</li>
              <li class="yes">Marketplace (5 paquetes)</li>
              <li class="yes">CRM básico</li>
              <li class="no">Dominio propio</li>
            </ul>
            <a href="/precios" class="ql-btn ql-btn-primary">Probar 7 días gratis</a>
          </article>

          <article class="ql-pricing-card featured reveal" style="transition-delay: 0.2s;">
            <span class="ql-badge">Más popular</span>
            <h3>Profesional</h3>
            <div class="ql-price">$XX<span>/mes</span></div>
            <ul class="ql-features">
              <li class="yes">Todo lo del Inicial</li>
              <li class="yes">Marketplace ilimitado</li>
              <li class="yes">Dominio propio</li>
              <li class="yes">Múltiples vendedores</li>
              <li class="yes">Reportes avanzados</li>
            </ul>
            <a href="/precios" class="ql-btn ql-btn-primary">Probar 7 días gratis</a>
          </article>
        </div>

        <p class="ql-pricing-tagline reveal">⚡ 7 días gratis. Sin tarjeta. Cancelás cuando quieras.</p>
      </div>
    </section>

    <!-- SECCIÓN 7: FAQ -->
    <section class="ql-section ql-section-dark" id="faq">
      <div class="ql-container">
        <h2 class="ql-section-title reveal">Preguntas frecuentes</h2>

        <div class="ql-faq reveal">
          <details class="ql-faq-item">
            <summary>¿El PDF lleva marca de Quotix? <span class="ql-arrow">▼</span></summary>
            <div class="ql-faq-answer">
              <p>No. El PDF lleva el logo, nombre y colores de tu agencia. Quotix es invisible para tu cliente.</p>
            </div>
          </details>
          <details class="ql-faq-item">
            <summary>¿Necesito saber usar Amadeus? <span class="ql-arrow">▼</span></summary>
            <div class="ql-faq-answer">
              <p>No. Podés cotizar desde cero sin Amadeus. Si lo usás, mejor.</p>
            </div>
          </details>
          <details class="ql-faq-item">
            <summary>¿Qué es el marketplace? <span class="ql-arrow">▼</span></summary>
            <div class="ql-faq-answer">
              <p>Es tu catálogo de paquetes como una tienda online. El cliente elige, cotiza y deja datos.</p>
            </div>
          </details>
          <details class="ql-faq-item">
            <summary>¿Puedo usar mi dominio? <span class="ql-arrow">▼</span></summary>
            <div class="ql-faq-answer">
              <p>Sí, en el plan Profesional.</p>
            </div>
          </details>
          <details class="ql-faq-item">
            <summary>¿Y si no me gusta después de probar? <span class="ql-arrow">▼</span></summary>
            <div class="ql-faq-answer">
              <p>Cancelás sin costo. No te pedimos tarjeta durante la prueba.</p>
            </div>
          </details>
          <details class="ql-faq-item">
            <summary>¿Cuánto tarda en estar listo? <span class="ql-arrow">▼</span></summary>
            <div class="ql-faq-answer">
              <p>10 minutos. Cargás tu logo, subís un paquete y ya tenés tu landing.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 8: CTA FINAL + FOOTER -->
    <section class="ql-section ql-section-cta" id="cta-final">
      <div class="ql-container">
        <h2 class="ql-section-title reveal">Dejá de perder ventas por falta de tiempo.</h2>
        <p class="ql-section-subtitle reveal">Quotix es gratis por 7 días. En 10 minutos ya tenés tu primer cotización.</p>
        <a href="/precios" class="ql-btn ql-btn-primary ql-btn-xl pulse reveal">Empezar gratis →</a>
        <p class="ql-cta-micro reveal">Sin tarjeta. Sin compromiso.</p>
      </div>
    </section>
  </main>

  <Footer />

  <style is:global>
    :root {
      --ql-bg: #0a0f1c;
      --ql-bg-alt: #0f172a;
      --ql-card: rgba(30, 41, 59, 0.6);
      --ql-card-solid: #1e293b;
      --ql-card-hover: #334155;
      --ql-text: #ffffff;
      --ql-text-secondary: #cbd5e1;
      --ql-text-muted: #94a3b8;
      --ql-accent: #bf3480;
      --ql-accent-hover: #d9469a;
      --ql-accent-light: #e879ab;
      --ql-lime: #d4f542;
      --ql-lime-dark: #0a0f1c;
      --ql-success: #22C55E;
      --ql-border: rgba(255,255,255,0.1);
    }

    .ql-page {
      background: var(--ql-bg);
      color: var(--ql-text);
      overflow-x: hidden;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .ql-page *,
    .ql-page *::before,
    .ql-page *::after {
      box-sizing: border-box;
    }

    .ql-container {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding-left: 16px;
      padding-right: 16px;
    }

    @media (min-width: 768px) {
      .ql-container {
        padding-left: 24px;
        padding-right: 24px;
      }
    }

    @media (min-width: 1024px) {
      .ql-container {
        padding-left: 48px;
        padding-right: 48px;
      }
    }

    .ql-section {
      padding: 80px 0;
    }

    @media (min-width: 1024px) {
      .ql-section {
        padding: 120px 0;
      }
    }

    .ql-section-dark { background: var(--ql-bg); }
    .ql-section-alt { background: var(--ql-bg-alt); }
    .ql-section-gradient {
      background:
        radial-gradient(ellipse at top, rgba(191, 52, 128, 0.10) 0%, transparent 60%),
        var(--ql-bg);
    }

    .ql-section-title {
      font-size: clamp(1.5rem, 4vw, 2.5rem);
      line-height: 1.2;
      font-weight: 700;
      text-align: center;
      margin-bottom: 16px;
    }

    .ql-section-subtitle {
      font-size: 1rem;
      color: var(--ql-text-secondary);
      text-align: center;
      max-width: 600px;
      margin: 0 auto 48px;
      line-height: 1.6;
    }

    /* Buttons */
    .ql-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 16px 32px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 1rem;
      text-decoration: none;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      border: none;
      cursor: pointer;
      min-height: 56px;
    }

    .ql-btn-primary {
      background: var(--ql-accent);
      color: #FFFFFF !important;
    }

    .ql-btn-primary:hover {
      background: var(--ql-accent-hover);
      transform: scale(1.02);
      box-shadow: 0 8px 24px rgba(191, 52, 128, 0.3);
    }

    .ql-btn-secondary {
      background: transparent;
      color: var(--ql-accent) !important;
      border: 1.5px solid var(--ql-accent);
    }

    .ql-btn-secondary:hover {
      background: rgba(191, 52, 128, 0.1);
    }

    .ql-btn-xl {
      min-height: 64px;
      font-size: 1.2rem;
      width: 100%;
      max-width: 420px;
    }

    @media (max-width: 767px) {
      .ql-btn {
        width: 100%;
      }
    }

    /* HERO */
    .ql-hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 96px 0 64px;
      background: var(--ql-bg);
    }

    .ql-hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .ql-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
    }

    .ql-hero-inner {
      position: relative;
      z-index: 1;
    }

    .ql-logo {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--ql-accent);
      margin-bottom: 24px;
      letter-spacing: -0.02em;
    }

    .ql-hero-title {
      font-size: clamp(2rem, 5vw, 3.5rem);
      line-height: 1.1;
      font-weight: 800;
      margin-bottom: 24px;
    }

    .ql-hero-subtitle {
      font-size: 1rem;
      color: var(--ql-text-secondary);
      max-width: 600px;
      margin: 0 auto 32px;
      line-height: 1.6;
    }

    .ql-hero-ctas {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 20px;
    }

    @media (min-width: 640px) {
      .ql-hero-ctas {
        flex-direction: row;
        justify-content: center;
      }
    }

    .ql-hero-micro {
      font-size: 0.875rem;
      color: var(--ql-text-muted);
      margin: 0;
    }

    /* PROBLEMA */
    .ql-problem-grid {
      display: grid;
      gap: 16px;
      margin-bottom: 40px;
    }

    @media (min-width: 768px) {
      .ql-problem-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .ql-card {
      background: var(--ql-card);
      border: 1px solid var(--ql-border);
      border-radius: 16px;
      padding: 24px;
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
      backdrop-filter: blur(4px);
    }

    .ql-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(0,0,0,0.3);
      border-color: rgba(191, 52, 128, 0.4);
    }

    .ql-card-icon {
      font-size: 2rem;
      margin-bottom: 16px;
    }

    .ql-card h3 {
      font-size: 1.125rem;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .ql-card p {
      color: var(--ql-text-secondary);
      font-size: 1rem;
      line-height: 1.6;
      margin: 0;
    }

    .ql-problem-close {
      text-align: center;
      font-size: 1.5rem;
      font-style: italic;
      color: var(--ql-accent-light);
      margin: 0;
    }

    /* FLUJO */
    .ql-flow {
      position: relative;
      margin: 48px 0 32px;
    }

    .ql-flow-line {
      position: absolute;
      top: 28px;
      left: 0;
      width: 100%;
      height: 80px;
      opacity: 0.5;
      z-index: 0;
      transition: stroke-dashoffset 1.2s ease;
    }

    .ql-flow-line.mobile {
      display: none;
    }

    .ql-flow-line.drawn path {
      stroke-dashoffset: 0;
    }

    @media (max-width: 1023px) {
      .ql-flow-line.desktop { display: none; }
      .ql-flow-line.mobile {
        display: block;
        top: 0;
        left: 28px;
        width: 60px;
        height: 100%;
      }
    }

    .ql-flow-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px 16px;
      position: relative;
      z-index: 1;
    }

    @media (min-width: 768px) {
      .ql-flow-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .ql-flow-grid {
        grid-template-columns: repeat(6, 1fr);
        gap: 16px;
      }
    }

    .ql-flow-step {
      text-align: center;
    }

    .ql-flow-circle {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: var(--ql-card);
      border: 1px solid var(--ql-border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin: 0 auto 12px;
      transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .ql-flow-step:hover .ql-flow-circle {
      transform: scale(1.08);
      border-color: var(--ql-accent);
    }

    .ql-flow-step h3 {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .ql-flow-step p {
      font-size: 0.875rem;
      color: var(--ql-text-secondary);
      margin: 0;
    }

    .ql-flow-tagline {
      text-align: center;
      font-size: 1.125rem;
      color: var(--ql-accent-light);
      margin: 32px 0 0;
      font-weight: 600;
    }

    /* PILARES */
    .ql-pillars-grid {
      display: grid;
      gap: 24px;
    }

    @media (min-width: 1024px) {
      .ql-pillars-grid {
        grid-template-columns: repeat(3, 1fr);
      }
      .ql-pillar:nth-child(2) {
        transform: translateY(40px);
      }
    }

    .ql-pillar {
      position: relative;
      background: var(--ql-card);
      border: 1px solid transparent;
      border-radius: 20px;
      padding: 32px;
      transition: border-color 0.3s ease, transform 0.3s ease;
      backdrop-filter: blur(4px);
    }

    .ql-pillar:hover {
      border-color: var(--ql-accent);
      transform: translateY(-4px);
    }

    @media (min-width: 1024px) {
      .ql-pillar:nth-child(2):hover {
        transform: translateY(36px);
      }
    }

    .ql-pillar-number {
      position: absolute;
      top: 16px;
      right: 24px;
      font-size: 4rem;
      font-weight: 800;
      color: var(--ql-text);
      opacity: 0.06;
      line-height: 1;
    }

    .ql-pillar h3 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .ql-pillar-hook {
      font-size: 1.1rem;
      color: var(--ql-accent) !important;
      margin-bottom: 20px;
      font-weight: 600;
    }

    .ql-pillar ul {
      list-style: none;
      padding: 0;
      margin: 0 0 24px;
    }

    .ql-pillar li {
      position: relative;
      padding-left: 24px;
      margin-bottom: 12px;
      color: var(--ql-text-secondary);
      font-size: 1rem;
      line-height: 1.5;
    }

    .ql-pillar li::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: var(--ql-lime);
      font-weight: 700;
    }

    .ql-pillar-link {
      color: var(--ql-accent);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.95rem;
      position: relative;
    }

    .ql-pillar-link::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -2px;
      width: 0;
      height: 1px;
      background: var(--ql-accent);
      transition: width 0.2s ease;
    }

    .ql-pillar-link:hover::after {
      width: 100%;
    }

    /* SOCIAL PROOF */
    .ql-testimonials {
      display: grid;
      gap: 24px;
      margin-bottom: 48px;
    }

    @media (min-width: 768px) {
      .ql-testimonials {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .ql-testimonial {
      position: relative;
      background: var(--ql-card);
      border: 1px solid var(--ql-border);
      border-radius: 16px;
      padding: 28px;
      overflow: hidden;
      backdrop-filter: blur(4px);
    }

    .ql-testimonial .ql-quote {
      position: absolute;
      top: 8px;
      left: 16px;
      font-size: 4rem;
      line-height: 1;
      color: var(--ql-lime);
      opacity: 0.2;
      font-family: Georgia, serif;
    }

    .ql-testimonial p {
      font-size: 1.1rem;
      font-style: italic;
      line-height: 1.6;
      margin: 0 0 16px;
      position: relative;
      z-index: 1;
      color: var(--ql-text-secondary);
    }

    .ql-testimonial footer {
      font-size: 0.875rem;
      color: var(--ql-text-muted);
    }

    .ql-stats {
      display: flex;
      justify-content: center;
      gap: 48px;
      flex-wrap: wrap;
    }

    .ql-stat {
      text-align: center;
    }

    .ql-stat-number {
      font-size: 3rem;
      font-weight: 800;
      color: var(--ql-lime);
      line-height: 1;
      margin-bottom: 8px;
    }

    .ql-stat-label {
      font-size: 0.875rem;
      color: var(--ql-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* PRECIOS */
    .ql-pricing-grid {
      display: grid;
      gap: 24px;
      max-width: 800px;
      margin: 0 auto 24px;
    }

    @media (min-width: 768px) {
      .ql-pricing-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .ql-pricing-card {
      position: relative;
      background: var(--ql-card);
      border: 1px solid var(--ql-border);
      border-radius: 20px;
      padding: 32px;
      display: flex;
      flex-direction: column;
      backdrop-filter: blur(4px);
    }

    .ql-pricing-card.featured {
      border-color: var(--ql-accent);
      box-shadow: 0 16px 48px rgba(191, 52, 128, 0.12);
    }

    .ql-badge {
      position: absolute;
      top: -12px;
      right: 24px;
      background: var(--ql-lime);
      color: var(--ql-lime-dark);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 6px 12px;
      border-radius: 999px;
    }

    .ql-pricing-card h3 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .ql-price {
      font-size: 2.5rem;
      font-weight: 800;
      margin-bottom: 24px;
      color: var(--ql-text);
    }

    .ql-price span {
      font-size: 1rem;
      color: var(--ql-text-muted);
      font-weight: 500;
    }

    .ql-features {
      list-style: none;
      padding: 0;
      margin: 0 0 32px;
      flex: 1;
    }

    .ql-features li {
      position: relative;
      padding-left: 28px;
      margin-bottom: 14px;
      font-size: 1rem;
      color: var(--ql-text-secondary);
    }

    .ql-features li.yes::before {
      content: '✅';
      position: absolute;
      left: 0;
      top: -1px;
      font-size: 0.9rem;
    }

    .ql-features li.no {
      color: var(--ql-text-muted);
      text-decoration: line-through;
    }

    .ql-features li.no::before {
      content: '❌';
      position: absolute;
      left: 0;
      top: -1px;
      font-size: 0.9rem;
      opacity: 0.5;
    }

    .ql-pricing-tagline {
      text-align: center;
      color: var(--ql-text-muted);
      font-size: 0.95rem;
      margin: 0;
    }

    /* FAQ */
    .ql-faq {
      max-width: 800px;
      margin: 0 auto;
    }

    .ql-faq-item {
      border-bottom: 1px solid var(--ql-border);
    }

    .ql-faq-item summary {
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 0;
      font-weight: 700;
      cursor: pointer;
      transition: color 0.2s ease;
    }

    .ql-faq-item summary:hover {
      color: var(--ql-accent-light);
    }

    .ql-faq-item summary::-webkit-details-marker {
      display: none;
    }

    .ql-arrow {
      transition: transform 0.3s ease;
      color: var(--ql-accent);
      font-size: 0.75rem;
    }

    .ql-faq-item[open] .ql-arrow {
      transform: rotate(180deg);
    }

    .ql-faq-answer {
      overflow: hidden;
      max-height: 0;
      transition: max-height 0.3s ease, padding 0.3s ease;
    }

    .ql-faq-item[open] .ql-faq-answer {
      max-height: 200px;
      padding-bottom: 20px;
    }

    .ql-faq-answer p {
      color: var(--ql-text-secondary);
      line-height: 1.6;
      margin: 0;
    }

    /* CTA FINAL */
    .ql-section-cta {
      text-align: center;
      background:
        radial-gradient(ellipse at center, rgba(191, 52, 128, 0.12) 0%, transparent 70%),
        var(--ql-bg);
      padding: 100px 0;
    }

    .ql-section-cta .ql-section-title {
      font-size: clamp(1.8rem, 5vw, 3rem);
    }

    .ql-cta-micro {
      color: var(--ql-text-muted);
      font-size: 0.875rem;
      margin-top: 16px;
    }

    /* PULSE */
    @keyframes ql-pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(191, 52, 128, 0.4); }
      50% { box-shadow: 0 0 0 12px rgba(191, 52, 128, 0); }
    }

    .ql-btn.pulse {
      animation: ql-pulse 3s ease-in-out infinite;
    }

    /* Reveal animations */
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
      .ql-btn.pulse {
        animation: none;
      }
      .ql-flow-line path {
        stroke-dashoffset: 0;
      }
    }
  </style>

  <script is:inline>
    (function() {
      // Scroll reveal
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

      // Flow line draw
      const flowSection = document.getElementById('flujo');
      if (flowSection) {
        const lineObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              document.querySelectorAll('.ql-flow-line').forEach(line => line.classList.add('drawn'));
              lineObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.3 });
        lineObserver.observe(flowSection);
      }

      // Counter animation
      const counters = document.querySelectorAll('.ql-stat-number');
      const countObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const target = parseInt(el.dataset.target, 10);
            const suffix = el.dataset.suffix || '';
            const duration = 1500;
            const startTime = performance.now();

            function update(now) {
              const progress = Math.min((now - startTime) / duration, 1);
              const ease = 1 - Math.pow(1 - progress, 3);
              el.textContent = Math.floor(ease * target) + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
            countObserver.unobserve(el);
          }
        });
      }, { threshold: 0.5 });

      counters.forEach(counter => countObserver.observe(counter));

      // FAQ: only one open at a time + smooth height
      const faqItems = document.querySelectorAll('.ql-faq-item');
      faqItems.forEach(item => {
        item.addEventListener('toggle', () => {
          if (item.open) {
            faqItems.forEach(other => {
              if (other !== item && other.open) other.open = false;
            });
          }
        });
      });
    })();
  </script>
</MainLayout>
