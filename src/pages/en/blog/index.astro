---
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';

const title = 'Quotix Blog | Software, PNR and Travel Agency Quotes';
const description = 'Practical guides for travel agencies: Amadeus PNR, PDF quotes, travel agency software, and best practices to sell more trips.';
const canonical = '/en/blog/';

const posts = [
  {
    slug: '/en/blog/what-is-pnr/',
    title: 'What is a PNR? Complete Guide for Travel Agents 2026',
    excerpt: 'Discover what a Passenger Name Record is, how it is structured in Amadeus, and why you should not send it raw to your clients.',
    image: '/images/blog/boarding-pass.jpg',
    category: 'PNR Guide',
    date: 'Jul 21, 2026',
    readTime: '8 min'
  },
  {
    slug: '/en/blog/calculate-commissions-pnr/',
    title: 'How to Calculate Commissions from a PNR Without Errors',
    excerpt: 'Learn how to read commission fields in an Amadeus PNR, apply markup correctly, and protect your agency margin.',
    image: '/images/blog/travel-counters.jpg',
    category: 'Business',
    date: 'Jul 21, 2026',
    readTime: '10 min'
  },
  {
    slug: '/en/blog/convert-pnr-to-pdf/',
    title: 'How to Convert a PNR to a Professional PDF in 3 Steps',
    excerpt: 'Convert an Amadeus PNR into a professional PDF ready to send. Save time, avoid transcription errors, and sell more trips.',
    image: '/images/blog/airport-checkin.jpg',
    category: 'PNR Tutorial',
    date: 'Jul 21, 2026',
    readTime: '9 min'
  },
  {
    slug: '/en/blog/how-to-read-amadeus-pnr/',
    title: 'How to Read an Amadeus PNR Step by Step | Guide 2026',
    excerpt: 'Learn to interpret the cryptic Amadeus format: itineraries, status codes, time limits, and name fields.',
    image: '/images/blog/flight-screen.jpg',
    category: 'PNR Tutorial',
    date: 'Jul 21, 2026',
    readTime: '10 min'
  }
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Quotix Blog',
  url: 'https://www.quotixos.com/en/blog/',
  description: description,
  blogPost: posts.map(post => ({
    '@type': 'BlogPosting',
    headline: post.title,
    url: `https://www.quotixos.com${post.slug}`,
    datePublished: '2026-07-21',
    author: {
      '@type': 'Person',
      name: 'Horacio'
    }
  }))
});
---

<MainLayout title={title} description={description} canonical={canonical} schema={schema}>
  <Header />

  <main class="pt-24 pb-16 bg-slate-50 min-h-screen">
    <div class="container-custom max-w-5xl mx-auto">
      <div class="max-w-3xl mb-12">
        <span class="inline-block px-3 py-1 text-xs font-semibold tracking-wide text-magenta bg-magenta/10 rounded-full mb-4">
          Blog
        </span>
        <h1 class="heading-lg text-slate-900 mb-4">Quotix Blog</h1>
        <p class="body-lg text-slate-600">
          Practical guides for travel agencies: Amadeus PNR, PDF quotes, travel agency software, and best practices to sell more trips.
        </p>
      </div>

      <div class="grid gap-8">
        {posts.map(post => (
          <article class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <div class="grid md:grid-cols-[300px_1fr] gap-0">
              <a href={post.slug} class="block h-48 md:h-full overflow-hidden">
                <img src={post.image} alt={post.title} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
              </a>
              <div class="p-6 md:p-8">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
                  <span class="text-xs font-semibold text-magenta uppercase tracking-wide">{post.category}</span>
                  <span class="text-sm text-slate-400">{post.date} • {post.readTime}</span>
                </div>
                <h2 class="heading-sm text-slate-900 mb-3">
                  <a href={post.slug} class="hover:text-magenta transition-colors">{post.title}</a>
                </h2>
                <p class="text-slate-600 mb-4 leading-relaxed">{post.excerpt}</p>
                <a href={post.slug} class="inline-flex items-center text-sm font-semibold text-magenta hover:text-magenta-500 transition-colors">
                  Read article
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</MainLayout>