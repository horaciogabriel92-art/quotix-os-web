---
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';

const title = 'Blog de Quotix | Software, PNR y Cotizaciones para Agencias de Viajes';
const description = 'Guías prácticas para agencias de viajes: PNR Amadeus, cotizaciones PDF, software de gestión y mejores prácticas para vender más viajes.';
const canonical = '/blog/';

const posts = [
  {
    slug: '/blog/que-es-pnr/',
    title: '¿Qué es un PNR? Guía Completa para Agentes de Viajes 2026',
    excerpt: 'Descubrí qué es el Passenger Name Record, cómo se estructura en Amadeus y por qué no deberías enviarlo en bruto a tus clientes.',
    image: '/images/blog/boarding-pass.jpg',
    category: 'Guía PNR',
    date: '21 jul 2026',
    readTime: '8 min'
  },
  {
    slug: '/blog/convertir-pnr-pdf/',
    title: 'Cómo Convertir un PNR a PDF Profesional en 3 Pasos',
    excerpt: 'Convertí un PNR de Amadeus en un PDF profesional listo para enviar. Ahorrá tiempo, evitá errores de transcripción y vendé más viajes.',
    image: '/images/blog/airport-checkin.jpg',
    category: 'Tutorial PNR',
    date: '21 jul 2026',
    readTime: '9 min'
  },
  {
    slug: '/blog/como-leer-pnr-amadeus/',
    title: 'Cómo Leer un PNR de Amadeus Paso a Paso | Guía 2026',
    excerpt: 'Aprendé a interpretar el formato críptico de Amadeus: itinerarios, códigos de estado, tiempos límite y campos de nombre.',
    image: '/images/blog/flight-screen.jpg',
    category: 'Tutorial PNR',
    date: '21 jul 2026',
    readTime: '10 min'
  }
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog de Quotix',
  url: 'https://www.quotixos.com/blog/',
  description: description,
  blogPost: posts.map(post => ({
    '@type': 'BlogPosting',
    headline: post.title,
    url: `https://www.quotixos.com${post.slug}`,
    datePublished: '2026-07-21',
    author: {
      '@type': 'Person',
      name: 'Horacio'
    }
  }))
});
---

<MainLayout title={title} description={description} canonical={canonical} schema={schema}>
  <Header />

  <main class="pt-28 pb-20 bg-white min-h-screen">
    <div class="container-custom max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Header -->
      <div class="max-w-3xl mb-16">
        <span class="inline-block px-4 py-1.5 text-xs font-bold tracking-widest text-[#bf3480] bg-[#bf3480]/10 rounded-full mb-5">
          BLOG
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-tight tracking-tight mb-5">
          Blog de Quotix
        </h1>
        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed">
          Guías prácticas para agencias de viajes: PNR Amadeus, cotizaciones PDF, software de gestión y mejores prácticas para vender más viajes.
        </p>
      </div>

      <!-- Featured / Grid -->
      <div class="grid gap-10">
        {posts.map((post, index) => (
          <article class={`group bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 ${index === 0 ? 'ring-1 ring-[#bf3480]/10' : ''}`}>
            <div class="grid md:grid-cols-[320px_1fr] lg:grid-cols-[400px_1fr] gap-0">
              <a href={post.slug} class="block h-56 md:h-full overflow-hidden relative">
                <img src={post.image} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading={index === 0 ? 'eager' : 'lazy'} />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              </a>
              <div class="p-7 md:p-10 flex flex-col justify-center">
                <div class="flex flex-wrap items-center gap-3 mb-4">
                  <span class="px-3 py-1 text-xs font-bold text-[#bf3480] bg-[#bf3480]/10 rounded-full uppercase tracking-wide">
                    {post.category}
                  </span>
                  <span class="text-sm text-slate-400">{post.date} • {post.readTime}</span>
                </div>
                <h2 class="text-2xl md:text-3xl font-bold text-slate-900 leading-tight mb-4 group-hover:text-[#bf3480] transition-colors">
                  <a href={post.slug}>{post.title}</a>
                </h2>
                <p class="text-slate-600 text-lg leading-relaxed mb-6">
                  {post.excerpt}
                </p>
                <a href={post.slug} class="inline-flex items-center text-base font-bold text-[#bf3480] hover:text-[#d9469a] transition-colors group/link">
                  Leer artículo
                  <svg class="w-5 h-5 ml-2 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty state / CTA -->
      <div class="mt-20 text-center">
        <div class="max-w-2xl mx-auto bg-gradient-to-br from-[#0f172a] to-[#1e293b] rounded-2xl p-8 md:p-12 text-white">
          <div class="text-4xl mb-4">📬</div>
          <h3 class="text-2xl md:text-3xl font-bold mb-4">¿Querés recibir las próximas guías?</h3>
          <p class="text-slate-300 text-lg mb-8">
            Publicamos contenido práctico para agencias de viajes que quieren vender más con menos esfuerzo.
          </p>
          <a href="/precios" class="inline-flex items-center justify-center px-8 py-4 bg-[#bf3480] hover:bg-[#d9469a] text-white font-bold rounded-full transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
            Probar Quotix gratis 7 días
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</MainLayout>
