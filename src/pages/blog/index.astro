---
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';

const title = 'Blog de Quotix | Software, PNR y Cotizaciones para Agencias de Viajes';
const description = 'Guías prácticas para agencias de viajes: PNR Amadeus, cotizaciones PDF, software de gestión y mejores prácticas para vender más viajes.';
const canonical = '/blog/';

const posts = [
  {
    slug: '/blog/que-es-pnr/',
    title: '¿Qué es un PNR? Guía Completa para Agentes de Viajes 2026',
    excerpt: 'Descubrí qué es el Passenger Name Record, cómo se estructura en Amadeus y por qué no deberías enviarlo en bruto a tus clientes.',
    category: 'Guía PNR',
    date: '21 jul 2026',
    readTime: '8 min'
  },
  {
    slug: '/blog/como-leer-pnr-amadeus/',
    title: 'Cómo Leer un PNR de Amadeus Paso a Paso | Guía 2026',
    excerpt: 'Aprendé a interpretar el formato críptico de Amadeus: itinerarios, códigos de estado, tiempos límite y campos de nombre.',
    category: 'Tutorial PNR',
    date: '21 jul 2026',
    readTime: '10 min'
  }
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog de Quotix',
  url: 'https://www.quotixos.com/blog/',
  description: description,
  blogPost: posts.map(post => ({
    '@type': 'BlogPosting',
    headline: post.title,
    url: `https://www.quotixos.com${post.slug}`,
    datePublished: '2026-07-21',
    author: {
      '@type': 'Person',
      name: 'Horacio'
    }
  }))
});
---

<MainLayout title={title} description={description} canonical={canonical} schema={schema}>
  <Header />

  <main class="pt-24 pb-16 bg-slate-50 min-h-screen">
    <div class="container-custom max-w-5xl mx-auto">
      <div class="max-w-3xl mb-12">
        <span class="inline-block px-3 py-1 text-xs font-semibold tracking-wide text-magenta bg-magenta/10 rounded-full mb-4">
          Blog
        </span>
        <h1 class="heading-lg text-slate-900 mb-4">Blog de Quotix</h1>
        <p class="body-lg text-slate-600">
          Guías prácticas para agencias de viajes: PNR Amadeus, cotizaciones PDF, software de gestión y mejores prácticas para vender más viajes.
        </p>
      </div>

      <div class="grid gap-8">
        {posts.map(post => (
          <article class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-3">
              <span class="text-xs font-semibold text-magenta uppercase tracking-wide">{post.category}</span>
              <span class="text-sm text-slate-400">{post.date} • {post.readTime}</span>
            </div>
            <h2 class="heading-sm text-slate-900 mb-3">
              <a href={post.slug} class="hover:text-magenta transition-colors">{post.title}</a>
            </h2>
            <p class="text-slate-600 mb-4 leading-relaxed">{post.excerpt}</p>
            <a href={post.slug} class="inline-flex items-center text-sm font-semibold text-magenta hover:text-magenta-500 transition-colors">
              Leer artículo
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</MainLayout>