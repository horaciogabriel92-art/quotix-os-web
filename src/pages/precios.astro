---
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/sections/Header.astro';
import Pricing from '@/components/sections/Pricing.astro';
import Footer from '@/components/sections/Footer.astro';

const title = 'Planes y Precios de Quotix | Software para Agencias de Viajes';
const description = 'Elegí el plan ideal para tu agencia de viajes. PNR Converter, cotizaciones PDF, CRM y web de paquetes. Probá gratis 7 días sin tarjeta de crédito.';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Quotix',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: 'Software para agencias de viajes con planes Free, Freelance, Pro Agencia y Pro Ilimitado.',
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '0',
    highPrice: '79',
    priceCurrency: 'USD',
    offerCount: '4'
  },
  brand: {
    '@type': 'Brand',
    name: 'Quotix'
  },
  inLanguage: 'es'
});
---

<MainLayout title={title} description={description} schema={schema}>
  <Header />
  <main class="pt-16">
    <Pricing />

    <!-- SEO content adicional -->
    <section class="py-16 bg-white border-t border-slate-200">
      <div class="container-custom max-w-4xl mx-auto space-y-12">
        <div>
          <h2 class="heading-md text-slate-900 mb-4">Comparativa de planes de Quotix</h2>
          <p class="body-md text-slate-600">
            Todos los planes incluyen el PNR Converter y la prueba gratuita de 7 días. La diferencia principal está en la cantidad de usuarios, cotizaciones y acceso a funcionalidades como CRM avanzado, web de paquetes y control de comisiones.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
            <h3 class="text-xl font-bold text-slate-900 mb-3">Free</h3>
            <p class="text-slate-600">Ideal para probar la plataforma. Acceso al PNR Converter gratuito, cotizaciones básicas y la web de paquetes con funciones limitadas.</p>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
            <h3 class="text-xl font-bold text-slate-900 mb-3">Freelance</h3>
            <p class="text-slate-600">Para agentes independientes. Cotizaciones PDF con marca, CRM básico, control de clientes y seguimiento de oportunidades.</p>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
            <h3 class="text-xl font-bold text-slate-900 mb-3">Pro Agencia</h3>
            <p class="text-slate-600">Para agencias con equipo. Multi-vendedor, control de comisiones, más cotizaciones y acceso completo al CRM.</p>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
            <h3 class="text-xl font-bold text-slate-900 mb-3">Pro Ilimitado</h3>
            <p class="text-slate-600">Usuarios ilimitados, cotizaciones ilimitadas, web de paquetes personalizada y soporte prioritario. Ideal para agencias en crecimiento.</p>
          </div>
        </div>

        <div>
          <h2 class="heading-md text-slate-900 mb-4">Preguntas frecuentes sobre precios</h2>
          <div class="space-y-4">
            <details class="group bg-slate-50 border border-slate-200 rounded-xl p-4">
              <summary class="font-semibold text-slate-800 cursor-pointer list-none flex items-center justify-between">
                ¿Puedo probar antes de pagar?
                <span class="text-magenta group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-slate-600 mt-3 text-sm leading-relaxed">Sí, todos los planes tienen 7 días de prueba gratuita sin tarjeta de crédito.</p>
            </details>
            <details class="group bg-slate-50 border border-slate-200 rounded-xl p-4">
              <summary class="font-semibold text-slate-800 cursor-pointer list-none flex items-center justify-between">
                ¿Puedo cambiar de plan después?
                <span class="text-magenta group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-slate-600 mt-3 text-sm leading-relaxed">Sí, podés upgradear o downgradear tu plan en cualquier momento desde la configuración.</p>
            </details>
            <details class="group bg-slate-50 border border-slate-200 rounded-xl p-4">
              <summary class="font-semibold text-slate-800 cursor-pointer list-none flex items-center justify-between">
                ¿El PNR Converter es gratis?
                <span class="text-magenta group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-slate-600 mt-3 text-sm leading-relaxed">Sí, el PNR Converter es una herramienta gratuita que podés usar con o sin cuenta.</p>
            </details>
            <details class="group bg-slate-50 border border-slate-200 rounded-xl p-4">
              <summary class="font-semibold text-slate-800 cursor-pointer list-none flex items-center justify-between">
                ¿Hay contratos de permanencia?
                <span class="text-magenta group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-slate-600 mt-3 text-sm leading-relaxed">No. Podés cancelar en cualquier momento sin penalizaciones.</p>
            </details>
          </div>
        </div>

        <div class="text-center bg-gradient-to-br from-navy to-navy-800 rounded-2xl p-8 text-white">
          <h3 class="heading-md mb-3">¿Dudas sobre qué plan elegir?</h3>
          <p class="body-md text-slate-300 mb-6">Probá gratis 7 días y elegí el plan que mejor se adapte a tu agencia.</p>
          <a href="/registro?plan=freelance" class="inline-flex items-center justify-center px-8 py-3 bg-magenta hover:bg-magenta-500 text-white font-semibold rounded-full transition-colors">
            Empezar prueba gratis
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>