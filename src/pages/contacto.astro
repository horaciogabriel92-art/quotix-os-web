---
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';

const title = 'Contacto | Quotix - Software para Agencias de Viajes';
const description = 'Contactá al equipo de Quotix. Soporte, ventas y consultas para agencias de viajes que quieren cotizar más rápido con PNR y PDF profesionales.';
const canonical = '/contacto';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto Quotix',
  url: 'https://www.quotixos.com/contacto',
  description: 'Formulario y datos de contacto de Quotix para agencias de viajes.'
});
---

<MainLayout title={title} description={description} canonical={canonical} schema={schema}>
  <Header />
  <main>
    <section class="section-padding bg-white">
      <div class="container-custom max-w-4xl">
        <div class="text-center mb-12">
          <h1 class="heading-xl text-slate-900 mb-4">Contacto</h1>
          <p class="body-lg text-slate-600">¿Tenés preguntas? Escribinos y te respondemos en menos de 24 horas.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-10">
          <div class="space-y-6">
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
              <h2 class="font-semibold text-slate-900 mb-2">Email</h2>
              <a href="mailto:hola@quotixos.com" class="text-[#bf3480] hover:underline">hola@quotixos.com</a>
            </div>
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
              <h2 class="font-semibold text-slate-900 mb-2">WhatsApp</h2>
              <a href="https://wa.me/59899123456" target="_blank" rel="noopener noreferrer" class="text-[#bf3480] hover:underline">+598 99 123 456</a>
            </div>
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
              <h2 class="font-semibold text-slate-900 mb-2">Horario</h2>
              <p class="text-slate-600">Lunes a viernes de 9:00 a 18:00 (GMT-3).</p>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
            <form class="space-y-4" action="https://formspree.io/f/xnnjvnyv" method="POST">
              <div>
                <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Nombre</label>
                <input type="text" id="name" name="name" required class="w-full rounded-lg border-slate-300 px-4 py-2 focus:border-[#bf3480] focus:ring-[#bf3480]" />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email</label>
                <input type="email" id="email" name="email" required class="w-full rounded-lg border-slate-300 px-4 py-2 focus:border-[#bf3480] focus:ring-[#bf3480]" />
              </div>
              <div>
                <label for="message" class="block text-sm font-medium text-slate-700 mb-1">Mensaje</label>
                <textarea id="message" name="message" rows="4" required class="w-full rounded-lg border-slate-300 px-4 py-2 focus:border-[#bf3480] focus:ring-[#bf3480]"></textarea>
              </div>
              <button type="submit" class="btn-primary btn-filled-dark w-full">Enviar mensaje</button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>
