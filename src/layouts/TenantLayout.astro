---
import '@/styles/global.css';
import TenantHeader from '@/components/tenant/TenantHeader.astro';
import TenantFooter from '@/components/tenant/TenantFooter.astro';

interface Props {
  tenant: any;
  landing: any;
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  schema?: string;
}

const { tenant, landing, title, description, ogImage, canonical, schema } = Astro.props;

const siteUrl = 'https://travel.quotixos.com';
const canonicalUrl = canonical ? (canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`) : `${siteUrl}/${tenant.slug}`;
const pageTitle = title || `${landing.titulo || tenant.nombre} — Cotizá tu próximo viaje`;
const pageDescription = description || landing.descripcion || `Catálogo de paquetes turísticos de ${tenant.nombre}`;
const pageOg = ogImage || landing.imagen_og || tenant.logo_url || 'https://www.quotixos.com/og-image.png';

const colors = {
  primary: landing.color_primario || '#0ea5e9',
  secondary: landing.color_secundario || '#6366f1',
  bg: landing.color_fondo || '#ffffff',
  text: landing.color_texto || '#0f172a'
};

const schemaOrg = schema || JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: landing.titulo || tenant.nombre,
  description: pageDescription,
  url: canonicalUrl,
  logo: tenant.logo_url,
  telephone: landing.telefono,
  email: landing.email,
  address: landing.direccion ? {
    '@type': 'PostalAddress',
    streetAddress: landing.direccion
  } : undefined,
  sameAs: landing.redes_sociales ? Object.values(landing.redes_sociales).filter(Boolean) : undefined
});
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDescription} />
  <meta name="theme-color" content={colors.primary} />
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={pageOg} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={pageOg} />

  {schemaOrg && <script type="application/ld+json" set:html={schemaOrg} />}

  <link rel="icon" type="image/svg+xml" href={tenant.logo_url || '/favicon.svg'} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <title>{pageTitle}</title>

  <style define:vars={{
    brandPrimary: colors.primary,
    brandSecondary: colors.secondary,
    brandBg: colors.bg,
    brandText: colors.text
  }}>
    :root {
      --brand-primary: var(--brandPrimary);
      --brand-secondary: var(--brandSecondary);
      --brand-bg: var(--brandBg);
      --brand-text: var(--brandText);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col" style={`background-color: ${colors.bg}; color: ${colors.text};`}>
  <TenantHeader tenant={tenant} landing={landing} />
  <main class="flex-1">
    <slot />
  </main>
  <TenantFooter tenant={tenant} landing={landing} />
</body>
</html>
