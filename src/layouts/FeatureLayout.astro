---
import MainLayout from './MainLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  schema?: string;
  h1: string;
  subtitle: string;
  heroImage?: string;
  heroAlt?: string;
}

const { title, description, canonical, ogImage, schema, h1, subtitle, heroImage, heroAlt } = Astro.props;
---

<MainLayout title={title} description={description} canonical={canonical} ogImage={ogImage} schema={schema}>
  <slot name="head" slot="head" />
  <Header />

  <main class="pt-24 pb-16 bg-slate-50 min-h-screen">
    <!-- Hero -->
    <section class="container-custom max-w-6xl mx-auto mb-16">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div class="max-w-2xl">
          <span class="inline-block px-3 py-1 text-xs font-semibold tracking-wide text-magenta bg-magenta/10 rounded-full mb-4">
            Software para agencias de viajes
          </span>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 leading-tight tracking-tight mb-5">
            {h1}
          </h1>
          <p class="text-lg md:text-xl text-slate-600 leading-relaxed mb-8">
            {subtitle}
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/precios" class="inline-flex items-center justify-center px-8 py-3.5 bg-magenta hover:bg-magenta-500 text-white font-semibold rounded-full transition-all shadow-lg hover:shadow-xl">
              Probar gratis 7 días
            </a>
            <a href="/pnr-converter" class="inline-flex items-center justify-center px-8 py-3.5 border border-slate-300 text-slate-700 hover:border-magenta hover:text-magenta font-semibold rounded-full transition-colors">
              Probar el conversor PNR
            </a>
          </div>
        </div>
        {heroImage && (
          <div class="rounded-2xl overflow-hidden shadow-xl border border-slate-200">
            <img src={heroImage} alt={heroAlt || h1} class="w-full h-auto object-cover" loading="eager" />
          </div>
        )}
      </div>
    </section>

    <!-- Content -->
    <div class="container-custom max-w-4xl mx-auto">
      <div class="bg-white border border-slate-200 rounded-2xl p-8 md:p-10 shadow-sm feature-content">
        <slot />
      </div>
    </div>

    <!-- CTA final -->
    <section class="container-custom max-w-4xl mx-auto mt-16">
      <div class="bg-gradient-to-br from-navy via-navy-800 to-navy-700 rounded-2xl p-8 md:p-12 text-white text-center shadow-lg relative overflow-hidden">
        <div class="absolute top-0 right-0 -mt-4 -mr-4 w-24 h-24 bg-magenta/20 rounded-full blur-2xl"></div>
        <div class="absolute bottom-0 left-0 -mb-4 -ml-4 w-20 h-20 bg-lime/10 rounded-full blur-2xl"></div>
        <div class="relative z-10">
          <h2 class="text-2xl md:text-3xl font-bold mb-4 leading-tight">¿Listo para transformar tu agencia de viajes?</h2>
          <p class="text-slate-300 text-lg mb-6 leading-relaxed">
            Unite a las agencias que cotizan en minutos con Quotix. Probá gratis 7 días sin tarjeta de crédito.
          </p>
          <a href="/precios" class="inline-flex items-center justify-center px-8 py-3.5 bg-magenta hover:bg-magenta-500 text-white font-semibold rounded-full transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
            Empezar prueba gratis
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>

<style is:global>
  .feature-content h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.25;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #f1f5f9;
  }
  .feature-content h2:first-of-type {
    margin-top: 0;
  }
  .feature-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #1e293b;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .feature-content .not-prose h2,
  .feature-content .not-prose h3,
  .feature-content .not-prose h4 {
    color: inherit;
    margin-top: 0;
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  .feature-content .not-prose p,
  .feature-content .not-prose li {
    color: inherit;
    margin-bottom: 0;
  }
  .feature-content .not-prose ul {
    margin-bottom: 0;
  }
  .feature-content p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #475569;
    margin-bottom: 1.25rem;
  }
  .feature-content ul {
    list-style: none;
    padding-left: 0;
    margin-bottom: 1.5rem;
  }
  .feature-content ul li {
    position: relative;
    padding-left: 1.75rem;
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
    color: #475569;
    line-height: 1.7;
  }
  .feature-content ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    width: 0.5rem;
    height: 0.5rem;
    background: linear-gradient(135deg, #bf3480, #d9469a);
    border-radius: 50%;
  }
  .feature-content a {
    font-weight: 500;
    text-decoration: none;
  }
  .feature-content p a,
  .feature-content li a,
  .feature-content details a {
    color: #bf3480;
  }
  .feature-content p a:hover,
  .feature-content li a:hover,
  .feature-content details a:hover {
    text-decoration: underline;
  }
  .feature-content strong {
    color: #0f172a;
  }
  .feature-content details {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.875rem;
    padding: 1.25rem;
    margin-bottom: 0.875rem;
  }
  .feature-content summary {
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
  }
  .feature-content summary::-webkit-details-marker {
    display: none;
  }
  .feature-content details[open] summary {
    margin-bottom: 0.75rem;
  }
  .feature-content details > p {
    color: #475569;
  }
</style>