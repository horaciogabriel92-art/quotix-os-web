---
import MainLayout from './MainLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import BlogTOC from '@/components/blog/BlogTOC';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  heroImage?: string;
  heroAlt?: string;
  schema?: string;
  publishDate: string;
  readTime: string;
  category?: string;
}

const { title, description, canonical, ogImage, heroImage, heroAlt, schema, publishDate, readTime, category = 'Blog' } = Astro.props;
const siteUrl = 'https://www.quotixos.com';
const canonicalUrl = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
---

<MainLayout title={title} description={description} canonical={canonical} ogImage={ogImage} schema={schema}>
  <Header />

  <main class="pt-24 pb-20 bg-white min-h-screen">
    <article class="container-custom max-w-6xl mx-auto">
      <!-- Header del artículo -->
      <header class="max-w-3xl mx-auto text-center mb-10 md:mb-14">
        <nav class="text-sm text-slate-500 mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:text-magenta transition-colors">Inicio</a>
          <span class="mx-2 text-slate-300">/</span>
          <a href="/blog/" class="hover:text-magenta transition-colors">Blog</a>
          <span class="mx-2 text-slate-300">/</span>
          <span class="text-slate-700">{category}</span>
        </nav>

        <span class="inline-block px-3 py-1 text-xs font-semibold tracking-wide text-magenta bg-magenta/10 rounded-full mb-4">
          {category}
        </span>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 leading-tight tracking-tight mb-5">
          {title}
        </h1>

        <p class="text-lg md:text-xl text-slate-600 leading-relaxed mb-6">
          {description}
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4 text-sm text-slate-500">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-magenta to-magenta-500 flex items-center justify-center text-white text-xs font-bold">
              H
            </div>
            <span class="font-medium text-slate-700">Horacio</span>
          </div>
          <span class="hidden md:inline text-slate-300">•</span>
          <span>{publishDate}</span>
          <span class="text-slate-300">•</span>
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {readTime} de lectura
          </span>
        </div>

        {heroImage && (
          <div class="mt-8 rounded-2xl overflow-hidden shadow-lg border border-slate-200">
            <img src={heroImage} alt={heroAlt || title} class="w-full h-auto object-cover" loading="eager" />
          </div>
        )}
      </header>

      <!-- Layout de contenido: TOC + artículo -->
      <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-8 lg:gap-12 items-start">
        <aside class="lg:sticky lg:top-28 order-2 lg:order-1">
          <BlogTOC client:load />
        </aside>

        <div class="order-1 lg:order-2">
          <div class="article-content max-w-2xl mx-auto lg:mx-0">
            <slot />
          </div>

          <!-- CTA final -->
          <div class="max-w-2xl mx-auto lg:mx-0 mt-14 bg-gradient-to-br from-navy via-navy-800 to-navy-700 rounded-2xl p-8 md:p-10 text-white text-center shadow-lg relative overflow-hidden">
            <div class="absolute top-0 right-0 -mt-4 -mr-4 w-24 h-24 bg-magenta/20 rounded-full blur-2xl"></div>
            <div class="absolute bottom-0 left-0 -mb-4 -ml-4 w-20 h-20 bg-lime/10 rounded-full blur-2xl"></div>
            <div class="relative z-10">
              <h3 class="text-2xl md:text-3xl font-bold mb-3 leading-tight">¿Armás cotizaciones para agencias de viajes?</h3>
              <p class="text-slate-300 text-lg mb-6 leading-relaxed">
                Con Quotix convertís PNRs en cotizaciones PDF con tu marca, hoteles, traslados y seguros en minutos.
              </p>
              <a href="/precios" class="inline-flex items-center justify-center px-8 py-3.5 bg-magenta hover:bg-magenta-500 text-white font-semibold rounded-full transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
                Probar Quotix gratis 7 días
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</MainLayout>

<style is:global>
  .article-content {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #334155;
  }

  .article-content > section {
    margin-bottom: 3rem;
  }

  .article-content > section:last-child {
    margin-bottom: 0;
  }

  .article-content p {
    margin-bottom: 1.25rem;
  }

  .article-content p:last-child {
    margin-bottom: 0;
  }

  .article-content h2 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.25;
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid #f1f5f9;
  }

  .article-content h2:first-of-type {
    margin-top: 0;
  }

  .article-content h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #1e293b;
    line-height: 1.35;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .article-content h4 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #1e293b;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .article-content a {
    color: #bf3480;
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .article-content a:hover {
    border-bottom-color: #bf3480;
  }

  .article-content strong {
    color: #0f172a;
    font-weight: 600;
  }

  .article-content em {
    color: #334155;
    font-style: italic;
  }

  .article-content ul,
  .article-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.75rem;
  }

  .article-content ul {
    list-style: none;
    padding-left: 0;
  }

  .article-content ul li {
    position: relative;
    padding-left: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .article-content ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    width: 0.5rem;
    height: 0.5rem;
    background: linear-gradient(135deg, #bf3480, #d9469a);
    border-radius: 50%;
  }

  .article-content ol {
    list-style: decimal;
    padding-left: 1.5rem;
  }

  .article-content ol li {
    margin-bottom: 0.75rem;
    padding-left: 0.5rem;
  }

  .article-content pre {
    background: #0f172a;
    color: #f8fafc;
    border-radius: 1rem;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.25);
  }

  .article-content code {
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Consolas, monospace;
    font-size: 0.95em;
  }

  .article-content pre code {
    color: #f8fafc;
    background: transparent;
    padding: 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .article-content :not(pre) > code {
    background: #f1f5f9;
    color: #0f172a;
    padding: 0.2rem 0.45rem;
    border-radius: 0.375rem;
    font-weight: 500;
  }

  .article-content details {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.875rem;
    padding: 1.25rem;
    margin-bottom: 0.875rem;
  }

  .article-content summary {
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
  }

  .article-content summary::-webkit-details-marker {
    display: none;
  }

  .article-content details[open] summary {
    margin-bottom: 0.75rem;
  }

  .article-content details > p {
    color: #475569;
    font-size: 1rem;
    line-height: 1.7;
  }

  .article-content blockquote {
    background: #fdf2f8;
    border-left: 4px solid #bf3480;
    border-radius: 0 1rem 1rem 0;
    padding: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
  }

  .article-content blockquote p {
    color: #831843;
    margin-bottom: 0;
  }

  /* CTA inline boxes */
  .article-content .cta-box {
    background: linear-gradient(135deg, #fdf2f8 0%, #f8fafc 100%);
    border: 1px solid #f1d5e5;
    border-radius: 1rem;
    padding: 1.5rem;
    margin: 2rem 0;
    text-align: center;
  }

  @media (min-width: 768px) {
    .article-content .cta-box {
      text-align: left;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }

  @media (max-width: 1023px) {
    .article-content {
      font-size: 1.125rem;
    }
  }
</style>