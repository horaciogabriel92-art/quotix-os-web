---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  schema?: string;
}

const { 
  title = "Quotix - Cotizaciones Profesionales para Agencias de Viajes",
  description = "Genera cotizaciones de paquetes turísticos en 3 minutos. PDFs profesionales, control de comisiones y parser PNR Amadeus integrado.",
  ogImage = "https://www.quotixos.com/og-image.png",
  canonical,
  schema
} = Astro.props;

const siteUrl = "https://www.quotixos.com";
const canonicalUrl = canonical ? (canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`) : null;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0f172a" />
  
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalUrl || siteUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  
  <!-- Schema JSON-LD -->
  {schema && <script type="application/ld+json" set:html={schema} />}
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  
  <title>{title}</title>
  
  <slot name="head" />
</head>
<body>
  <slot />
  
  <script>
    // Smooth scroll polyfill for Safari
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  </script>
</body>
</html>
