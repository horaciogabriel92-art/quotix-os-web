---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  schema?: string;
}

const { 
  title = "Quotix - Cotizaciones Profesionales para Agencias de Viajes",
  description = "Generá cotizaciones de paquetes turísticos en 3 minutos. PDFs profesionales, control de comisiones y conversor PNR para Amadeus.",
  ogImage = "https://www.quotixos.com/og-image.png",
  canonical,
  schema
} = Astro.props;

import '@/styles/global.css';
import { getLocaleFromPath, getAlternates, getOgLocale } from '@/data/i18nAlternates.js';

const siteUrl = "https://www.quotixos.com";
const canonicalUrl = canonical ? (canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`) : null;

const pathname = Astro.url.pathname;
const locale = getLocaleFromPath(pathname);
const lang = locale;
const ogLocale = getOgLocale(locale);
const alternates = getAlternates(pathname);
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0f172a" />
  
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  
  <!-- hreflang: versiones alternativas por idioma -->
  {alternates && (
    <>
      {Object.entries(alternates).map(([hrefLang, path]) => (
        <link rel="alternate" hreflang={hrefLang} href={`${siteUrl}${path}`} />
      ))}
      <link rel="alternate" hreflang="x-default" href={`${siteUrl}${alternates.es}`} />
    </>
  )}
  
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalUrl || siteUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={ogLocale} />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  
  <!-- Schema JSON-LD -->
  {schema && <script type="application/ld+json" set:html={schema} />}
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Fonts: non-blocking load -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
  </noscript>
  
  <title>{title}</title>

  <!-- Meta Pixel Code -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '404380705766408');
    fbq('track', 'PageView');
  </script>
  <noscript>
    <img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=404380705766408&ev=PageView&noscript=1"
      alt="" />
  </noscript>
  <!-- End Meta Pixel Code -->

  <slot name="head" />
</head>
<body>
  <slot />

  <script is:inline>
    // Smooth scroll polyfill for Safari
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Meta Pixel: track clicks on [data-fbq]
    document.addEventListener('click', function (e) {
      const el = e.target.closest('[data-fbq]');
      if (!el || typeof fbq !== 'function') return;
      const event = el.getAttribute('data-fbq');
      let params = {};
      try {
        params = JSON.parse(el.getAttribute('data-fbq-params') || '{}');
      } catch (_) {}
      fbq('track', event, params);
    });
  </script>
</body>
</html>
